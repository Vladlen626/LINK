<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console runner instead of a test framework: plain checks, no extra dependencies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The same platform as Link, so only the win-x64 natives of its speech packages are copied. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Link.Desktop\Link.Desktop.csproj" />
  </ItemGroup>

</Project>
