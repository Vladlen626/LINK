{
  "manifest_version": 3,
  "name": "LINK ChatGPT Companion",
  "version": "0.2.0",
  "description": "Connects LINK desktop requests to an existing ChatGPT conversation.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:43127/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINK ChatGPT Companion"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
