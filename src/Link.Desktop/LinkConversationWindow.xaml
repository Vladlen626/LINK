<Window x:Class="Link.Desktop.LinkConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link ChatGPT conversation" Width="500" Height="360"
        MinWidth="440" MinHeight="300" WindowStartupLocation="CenterOwner"
        Style="{StaticResource LinkWindowStyle}">
    <Grid>
        <Border Style="{StaticResource DialogTintStyle}" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="ChatGPT conversations" />
                <TextBlock x:Name="StatusText" Margin="0,5,0,10" Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Padding="3" Style="{StaticResource GlassCardStyle}">
                <ListBox x:Name="ConversationList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DisplayMemberPath="Title" SelectionChanged="ConversationList_OnSelectionChanged"
                         MouseDoubleClick="ConversationList_OnMouseDoubleClick" />
            </Border>

            <CheckBox x:Name="SummaryBox" Grid.Row="2" Margin="2,12,0,0"
                      Content="Start the new chat with a short summary of the current one"
                      ToolTip="The current chat writes the summary first; it goes with your next message as context" />

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Padding="14,7" Click="OpenChat_OnClick" Content="Open ChatGPT"
                        ToolTip="Show ChatGPT to open or start the chat for this project" />
                <Button x:Name="NewChatButton" Grid.Column="2" Margin="0,0,8,0" Padding="14,7" Click="NewChat_OnClick"
                        Content="New chat"
                        ToolTip="Your next message starts a new chat, in the same ChatGPT project as the current one" />
                <Button Grid.Column="3" MinWidth="78" Margin="0,0,8,0" Padding="14,7"
                        IsCancel="True" Content="Cancel" />
                <Button x:Name="LinkButton" Grid.Column="4" MinWidth="78" Padding="14,7"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Link_OnClick" Content="Link" />
            </Grid>
        </Grid>
    </Grid>
</Window>
