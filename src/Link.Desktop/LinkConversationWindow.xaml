<Window x:Class="Link.Desktop.LinkConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link ChatGPT conversation" Width="440" Height="330"
        MinWidth="380" MinHeight="280" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowSurfaceBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="ChatGPT conversations" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,10" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListBox x:Name="ConversationList" Grid.Row="1" Padding="4"
                 Background="{StaticResource InnerGlassBrush}"
                 BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                 DisplayMemberPath="Title" SelectionChanged="ConversationList_OnSelectionChanged"
                 MouseDoubleClick="ConversationList_OnMouseDoubleClick" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Padding="12,7" Click="Refresh_OnClick" Content="Refresh" />
            <Button Grid.Column="2" MinWidth="74" Margin="0,0,8,0" Padding="12,7"
                    IsCancel="True" Content="Cancel" />
            <Button x:Name="LinkButton" Grid.Column="3" MinWidth="74" Padding="12,7"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Link_OnClick" Content="Link" />
        </Grid>
    </Grid>
</Window>
