<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version brings Windows.Graphics.Capture; the output folder keeps its old name, so the
         user's Link.exe, its shortcuts and its autostart entry stay where they were. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Link.Desktop</RootNamespace>
    <AssemblyName>Link</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Link runs on Windows x64 only. Without a runtime identifier sherpa-onnx copies its natives for nine
         platforms (~230 MB); the output path stays bin\Release\net10.0-windows. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The embedded ChatGPT page; it runs on the Evergreen WebView2 Runtime that comes with Windows 11. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- Whisper on a Vulkan GPU for the large final model; without such a GPU Whisper.net loads the CPU runtime. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser bridge is checked over real loopback HTTP, on a free port. -->
    <InternalsVisibleTo Include="Link.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embedded ChatGPT page runs the companion's files, built in so that they always match this LINK. -->
    <EmbeddedResource Include="..\..\companion\content.js" LogicalName="ChatPage.content.js" />
    <EmbeddedResource Include="..\..\companion\embedded-host.js" LogicalName="ChatPage.embedded-host.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The agent's rules, tasks and specialists lie beside Link.exe: they can be changed without a new build. -->
    <Content Include="..\..\docs\harness\agent-rules.md" Link="harness\agent-rules.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\harness\perforce.md" Link="harness\perforce.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\harness\map-task.md" Link="harness\map-task.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\harness\team-task.md" Link="harness\team-task.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\harness\roles\*.md" Link="harness\roles\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Vulkan runtime copies its Linux build too, unconditionally; Link runs on Windows only. -->
  <Target Name="SkipLinuxVulkanRuntime" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/vulkan/linux'))" />
    </ItemGroup>
  </Target>

</Project>
