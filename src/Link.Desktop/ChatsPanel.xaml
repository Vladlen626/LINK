<UserControl x:Class="Link.Desktop.ChatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The project's chats, as the sidebar of a chat app and of the Studio's tasks: the one Link talks in marked "here",
         the one shown lit; a click shows a chat and goes on in it. -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Button x:Name="NewChatButton" Margin="10,10,10,0" Height="34" Padding="10,0" HorizontalContentAlignment="Stretch"
                    Style="{StaticResource GhostButtonStyle}" Click="NewChat_OnClick"
                    ToolTip="Your next message starts a new chat, in the same ChatGPT project as the current one">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource PlusIconGeometry}"
                          Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="New chat" />
                    <Path Grid.Column="2" Width="8" Margin="6,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                          Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
            </Button>

            <!-- How the chat stands: connected, signing in, unavailable; a click shows the ChatGPT page. -->
            <Button x:Name="ConnectionButton" Grid.Row="1" Margin="10,2,10,4" Height="28" Padding="10,2" HorizontalContentAlignment="Left"
                    Style="{StaticResource GhostButtonStyle}" Click="OpenChat_OnClick"
                    ToolTip="Show Link's ChatGPT page: sign in, or look at the whole chat">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Margin="2,0,11,0" VerticalAlignment="Center" Fill="{StaticResource IdleOrbBrush}" />
                    <TextBlock x:Name="ConnectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,0,4,8">
                    <TextBlock Margin="10,8,6,4" Style="{StaticResource SectionLabelStyle}" FontSize="12" Text="CHATS" />
                    <TextBlock x:Name="ChatsEmptyText" Margin="10,4,6,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="No chats yet: ask something below, and its chat appears here." />
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarRowStyle}" Click="ChatRow_OnClick"
                                        ToolTip="Show the chat: its questions and answers; your next message goes there">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Viewbox Width="14" Height="14" Margin="0,2,9,0" VerticalAlignment="Top">
                                            <Path Data="{StaticResource ChatIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Center" CornerRadius="6"
                                                        Background="{StaticResource ActiveContextBrush}" Visibility="{Binding CurrentVisibility}"
                                                        ToolTip="Link talks in this chat">
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}" Text="here" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Margin="8,1,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Time}" />
                                            </Grid>
                                            <TextBlock Margin="0,1,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Preview}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
