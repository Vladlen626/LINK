<UserControl x:Class="Link.Desktop.ChatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="ReadTextStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- A chat's thread: the questions on the right, the answers on the left. -->
        <DataTemplate DataType="{x:Type local:ThreadUser}">
            <Border Margin="36,10,0,0" HorizontalAlignment="Right" Padding="10,7" CornerRadius="10,10,3,10"
                    Background="{StaticResource ActiveContextBrush}">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                    <Button Margin="-6,3,0,0" Padding="6,1" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                            Click="UserWords_OnClick" Visibility="{Binding ToggleVisibility}">
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding ToggleLabel}" />
                    </Button>
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Carried}"
                               TextWrapping="Wrap" Visibility="{Binding CarriedVisibility}" />
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding Time}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadAnswer}">
            <Border Margin="0,10,20,0" Padding="10,8" CornerRadius="10,10,10,3" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Time}" />
                        <Button Grid.Column="1" Padding="6,1" Style="{StaticResource GhostButtonStyle}" Click="ShowAnswer_OnClick"
                                ToolTip="Show the whole answer in Link's card, with Ask again and → Agent task">
                            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="Show in Link" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The project's chats, the one Link talks in marked; a click goes on in that chat. -->
        <Grid x:Name="ListView">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="CHATS" />
                <Button x:Name="NewChatButton" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Height="26" Click="NewChat_OnClick"
                        ToolTip="Your next message starts a new chat, in the same ChatGPT project as the current one">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource PlusIconGeometry}"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock VerticalAlignment="Center" Text="New chat ▾" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- How the chat stands: connected, signing in, unavailable; Open shows the ChatGPT page. -->
            <Button x:Name="ConnectionButton" Grid.Row="1" Style="{StaticResource GhostButtonStyle}" Height="26" Margin="-8,6,0,0" Padding="8,2"
                    HorizontalContentAlignment="Left" Click="OpenChat_OnClick" ToolTip="Show Link's ChatGPT page: sign in, or look at the whole chat">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource IdleOrbBrush}" />
                    <TextBlock x:Name="ConnectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
            <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock x:Name="ChatsEmptyText" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="No chats yet: ask something in Link, and its chat appears here." />
                    <ItemsControl x:Name="ChatList" Margin="-8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,2" Padding="8,6" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButtonStyle}"
                                        Click="ChatRow_OnClick" ToolTip="Open the chat: its questions and answers; your next message goes there">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Viewbox Width="13" Height="13" Margin="0,2,9,0" VerticalAlignment="Top">
                                            <Path Data="{StaticResource ChatIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Viewbox>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12" FontWeight="{Binding Weight}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Center" CornerRadius="6"
                                                        Background="{StaticResource ActiveContextBrush}" Visibility="{Binding CurrentVisibility}">
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextBrush}" Text="here" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Text="{Binding Time}" />
                                            </Grid>
                                            <TextBlock Margin="0,2,0,0" MaxHeight="32" FontSize="11.5" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{StaticResource MutedBrush}" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- One chat: what was asked through Link and what came back, the newest at the end. -->
        <Grid x:Name="ThreadView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderIconButtonStyle}" Margin="-6,0,2,0" VerticalAlignment="Center" Click="Back_OnClick"
                        ToolTip="All chats of the project">
                    <Path Width="9" Height="12" Stretch="Uniform" Data="{StaticResource BackIconGeometry}" Stroke="{StaticResource TextBrush}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <TextBlock x:Name="ThreadTitle" Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <Button x:Name="OpenThreadButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="24" Margin="6,0,0,0"
                        Click="OpenThread_OnClick" Content="ChatGPT page"
                        ToolTip="Show this chat on Link's ChatGPT page, with what was said there outside Link" />
            </Grid>
            <ScrollViewer x:Name="ThreadScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,8">
                    <TextBlock x:Name="ThreadEmptyText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Link has sent nothing to this chat yet; what was said there outside Link is on its ChatGPT page." />
                    <ItemsControl x:Name="ThreadList" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="ThreadHintText" Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
