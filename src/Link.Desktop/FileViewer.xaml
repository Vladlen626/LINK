<UserControl x:Class="Link.Desktop.FileViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Back (Esc), what is open and where it lives, and Explorer for anything Link does not show. -->
        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="10,7,12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButtonStyle}" Padding="8,4" Click="Back_OnClick" ToolTip="Back to the tab (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource BackIconGeometry}" Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" FontSize="13" Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="WhereText" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="26" Content="Show in Explorer" Click="Explorer_OnClick"
                        ToolTip="The file in its folder: open it with its own app from there" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A folder's or a set's files: a click shows one. -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FilesList" Margin="6,8,6,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ViewerFile}">
                                <Button Style="{StaticResource SidebarRowStyle}" Click="File_OnClick" ToolTip="{Binding Path}">
                                    <StackPanel>
                                        <TextBlock x:Name="Name" FontSize="12" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Folder}"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding FolderVisibility}" />
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- The file itself; the code builds what fits its kind. -->
            <Border x:Name="Body" Grid.Column="1" />
        </Grid>

        <!-- Opened from a task: comments on words, a point of a picture or a whole file go to the task's agent. -->
        <Border x:Name="CommentBar" Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="14,8,14,10"
                Visibility="Collapsed">
            <StackPanel>
                <ItemsControl x:Name="CommentsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Number}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12.5" Text="{Binding Comment.Text}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource TinyIconButtonStyle}" Click="RemoveComment_OnClick" ToolTip="Remove this comment">
                                    <Path Width="9" Height="9" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PlaceText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="CommentBox" Margin="0,3,0,0" Style="{StaticResource BareTextBoxStyle}" Padding="0,2" FontSize="13" MaxHeight="120"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="CommentBox_OnPreviewKeyDown"
                                 TextChanged="CommentBox_OnTextChanged" />
                    </StackPanel>
                    <Button x:Name="AddCommentButton" Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Bottom" Style="{StaticResource ChipButtonStyle}"
                            Click="AddComment_OnClick" Content="Add" ToolTip="Keep the comment on its place (Enter; Shift+Enter for a new line)" />
                    <Button x:Name="SendCommentsButton" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Height="30"
                            Click="SendComments_OnClick" ToolTip="All the comments go to the task's agent as your next words: it answers each" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
