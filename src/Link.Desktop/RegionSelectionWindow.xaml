<Window x:Class="Link.Desktop.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Region" AllowsTransparency="True" Background="#22000000"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross" KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        MouseMove="Window_OnMouseMove"
        MouseLeftButtonUp="Window_OnMouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder"
                Background="#2276A8FF" BorderBrush="#FF76A8FF" BorderThickness="2"
                Visibility="Collapsed" />
        <Border Canvas.Left="20" Canvas.Top="20" Padding="10,6" Background="#DD111318" CornerRadius="6">
            <TextBlock Text="Drag to select · Esc to cancel" />
        </Border>
    </Canvas>
</Window>
