<Window x:Class="Link.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Settings" Width="520" Height="650" MinWidth="460" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Settings" />
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Opacity" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Slider x:Name="OpacitySlider" Width="210" Minimum="0.45" Maximum="1" TickFrequency="0.05" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Voice language" />
            <ComboBox x:Name="VoiceLanguageCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Screenshot history" />
            <TextBox x:Name="HistorySizeBox" Grid.Column="1" Width="70" HorizontalAlignment="Left" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Click-through" />
            <ComboBox x:Name="ClickThroughCombo" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,16,0,0">
            <CheckBox x:Name="AlwaysOnTopBox" Margin="0,0,0,10" Content="Always on top" />
            <CheckBox x:Name="LaunchWithWindowsBox" Content="Launch with Windows" />
        </StackPanel>
        <TextBlock Grid.Row="6" Margin="0,22,0,8" FontSize="15" FontWeight="SemiBold" Text="Global hotkeys" />
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" />
                <RowDefinition Height="38" /><RowDefinition Height="38" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Show / hide" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Push to talk" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Capture desktop" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Capture active window" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Select region" />
            <TextBox x:Name="ShowHideHotkey" Grid.Column="1" Tag="ShowHide" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
            <TextBox x:Name="PushToTalkHotkey" Grid.Row="1" Grid.Column="1" Tag="PushToTalk" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
            <TextBox x:Name="DesktopHotkey" Grid.Row="2" Grid.Column="1" Tag="Desktop" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
            <TextBox x:Name="WindowHotkey" Grid.Row="3" Grid.Column="1" Tag="Window" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
            <TextBox x:Name="RegionHotkey" Grid.Row="4" Grid.Column="1" Tag="Region" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
        </Grid>
        <Grid Grid.Row="9" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="#FFFF7D8A" TextWrapping="Wrap" />
            <Button Grid.Column="1" Margin="8,0" Click="Cancel_OnClick" Content="Cancel" />
            <Button Grid.Column="2" Background="{StaticResource AccentBrush}" Foreground="#FF10141B" Click="Save_OnClick" Content="Save" />
        </Grid>
    </Grid>
</Window>
