<Window x:Class="Link.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Settings" Width="560" Height="720" MinWidth="500" MinHeight="620"
        PreviewKeyDown="Window_OnPreviewKeyDown" Style="{StaticResource LinkWindowStyle}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Border Style="{StaticResource DialogTintStyle}" />
        <Grid Margin="26,20,26,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Viewbox Width="30" Height="30">
                    <Path Data="{StaticResource LinkIconGeometry}" Fill="Transparent" Stroke="{StaticResource BrandBrush}"
                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <StackPanel Margin="12,-1,0,0">
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="Settings" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Make Link feel at home on your desktop" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Margin="2,0,0,6" Style="{StaticResource SectionLabelStyle}" Text="APPEARANCE" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Theme" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <ComboBox x:Name="ThemeCombo" Width="150" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                           Text="applies after restart" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Glass tint" />
                            <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                        ToolTip="Lower is more transparent" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" />
                            </Grid>
                            <CheckBox x:Name="BlurBackgroundBox" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                      Content="Blur what is behind Link (turn off for clear glass)" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,18,0,6" Style="{StaticResource SectionLabelStyle}" Text="BEHAVIOR" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="36" /><RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Click-through" />
                            <ComboBox x:Name="ClickThroughCombo" Grid.Column="1" Width="190" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Screenshot history" />
                            <TextBox x:Name="HistorySizeBox" Grid.Row="1" Grid.Column="1" Width="72" Height="32" HorizontalAlignment="Left" />
                            <CheckBox x:Name="AlwaysOnTopBox" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Always on top" />
                            <CheckBox x:Name="LaunchWithWindowsBox" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Launch with Windows" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,18,0,6" Style="{StaticResource SectionLabelStyle}" Text="VOICE" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Voice language" />
                            <ComboBox x:Name="VoiceLanguageCombo" Grid.Column="1" Width="190" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Input device" />
                            <ComboBox x:Name="MicrophoneCombo" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Check" />
                            <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="MicrophoneTestButton" Style="{StaticResource ChipButtonStyle}" Click="MicrophoneTest_OnClick"
                                        Content="Test microphone" />
                                <Border Grid.Column="1" Height="6" Margin="12,0,0,0" CornerRadius="3"
                                        Background="{StaticResource HairlineBrush}" ClipToBounds="True">
                                    <Border x:Name="MicrophoneLevelFill" CornerRadius="3" Background="{StaticResource SuccessBrush}"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="MicrophoneTestText" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="Test records three seconds and shows whether this microphone hears you." />
                        </Grid>
                    </Border>

                    <TextBlock Margin="2,18,0,6" Style="{StaticResource SectionLabelStyle}" Text="GLOBAL HOTKEYS" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="16,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                                <RowDefinition Height="42" /><RowDefinition Height="42" /><RowDefinition Height="42" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Show / hide" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Push to talk" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Send prompt" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Capture desktop" />
                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Capture active window" />
                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Select region" />
                            <Button x:Name="ShowHideHotkey" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+Space" />
                            </Button>
                            <Button x:Name="PushToTalkHotkey" Grid.Row="1" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+V" />
                            </Button>
                            <Button x:Name="SendHotkey" Grid.Row="2" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+Enter" />
                            </Button>
                            <Button x:Name="DesktopHotkey" Grid.Row="3" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+D" />
                            </Button>
                            <Button x:Name="WindowHotkey" Grid.Row="4" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+W" />
                            </Button>
                            <Button x:Name="RegionHotkey" Grid.Row="5" Grid.Column="1" Style="{StaticResource ShortcutRecorderStyle}" Click="HotkeyButton_OnClick">
                                <TextBlock Text="Ctrl+Alt+Shift+R" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="VersionText" Margin="2,12,0,0" Style="{StaticResource SecondaryTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Margin="8,0" Click="Cancel_OnClick" Content="Cancel" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="Save_OnClick" Content="Save changes" />
            </Grid>
        </Grid>
    </Grid>
</Window>
