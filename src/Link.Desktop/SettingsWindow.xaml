<Window x:Class="Link.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Settings" Width="560" Height="700" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowSurfaceBrush}">
    <Grid>
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Viewbox Width="34" Height="34">
                    <Path Data="{StaticResource LinkIconGeometry}" Fill="Transparent" Stroke="{StaticResource AquaBrush}"
                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <StackPanel Margin="12,-1,0,0">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Settings" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Make Link feel at home on your desktop" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Margin="3,0,0,7" Style="{StaticResource SectionLabelStyle}" Text="APPEARANCE &amp; BEHAVIOR" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" /><RowDefinition Height="48" /><RowDefinition Height="48" />
                                <RowDefinition Height="48" /><RowDefinition Height="40" /><RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Glass tint" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Slider x:Name="OpacitySlider" Width="190" Minimum="0.45" Maximum="1" TickFrequency="0.05" />
                                <TextBlock Width="38" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Voice language" />
                            <ComboBox x:Name="VoiceLanguageCombo" Grid.Row="1" Grid.Column="1" Width="190" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Screenshot history" />
                            <TextBox x:Name="HistorySizeBox" Grid.Row="2" Grid.Column="1" Width="78" Height="34" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Click-through" />
                            <ComboBox x:Name="ClickThroughCombo" Grid.Row="3" Grid.Column="1" Width="190" HorizontalAlignment="Left" />
                            <CheckBox x:Name="AlwaysOnTopBox" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Always on top" />
                            <CheckBox x:Name="LaunchWithWindowsBox" Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Center" Content="Launch with Windows" />
                        </Grid>
                    </Border>

                    <TextBlock Margin="3,20,0,7" Style="{StaticResource SectionLabelStyle}" Text="GLOBAL HOTKEYS" />
                    <Border Style="{StaticResource GlassCardStyle}" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" /><RowDefinition Height="46" /><RowDefinition Height="46" />
                                <RowDefinition Height="46" /><RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="Show / hide" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Push to talk" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Capture desktop" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Capture active window" />
                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Select region" />
                            <TextBox x:Name="ShowHideHotkey" Grid.Column="1" Height="34" Tag="ShowHide" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
                            <TextBox x:Name="PushToTalkHotkey" Grid.Row="1" Grid.Column="1" Height="34" Tag="PushToTalk" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
                            <TextBox x:Name="DesktopHotkey" Grid.Row="2" Grid.Column="1" Height="34" Tag="Desktop" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
                            <TextBox x:Name="WindowHotkey" Grid.Row="3" Grid.Column="1" Height="34" Tag="Window" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
                            <TextBox x:Name="RegionHotkey" Grid.Row="4" Grid.Column="1" Height="34" Tag="Region" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" IsReadOnly="True" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                <Button Grid.Column="1" Margin="8,0" Click="Cancel_OnClick" Content="Cancel" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Click="Save_OnClick" Content="Save changes" />
            </Grid>
        </Grid>
    </Grid>
</Window>
