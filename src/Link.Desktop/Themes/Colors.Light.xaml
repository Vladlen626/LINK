<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="InkColor">#15212C</Color>
    <Color x:Key="MutedInkColor">#3F4D5B</Color>
    <Color x:Key="AccentColor">#D9580D</Color>
    <Color x:Key="ShadowColor">#0B1A2A</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedInkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentActionBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AquaBrush" Color="#16A9BE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2B9A47" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#CC2F46" />
    <SolidColorBrush x:Key="LinkTextBrush" Color="#B4470A" />
    <SolidColorBrush x:Key="BrandBrush" Color="#EC6A26" />
    <SolidColorBrush x:Key="GlyphEyeBrush" Color="#2B1810" />

    <!-- Window glass: the tint sits over the blurred backdrop, MainWindow scales its opacity. -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFF9FBFD" />
        <GradientStop Offset="1" Color="#FFEDF2F7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#38000000" />
    <LinearGradientBrush x:Key="RimLightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E6FFFFFF" />
        <GradientStop Offset="0.25" Color="#4DFFFFFF" />
        <GradientStop Offset="1" Color="#26FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RecordingRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF3DBF5C" />
        <GradientStop Offset="1" Color="#993DBF5C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFF3F6F9" />
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FAF9FBFD" />

    <!-- Content surfaces stay denser than the shell so text keeps its contrast on any backdrop. -->
    <SolidColorBrush x:Key="CardBrush" Color="#8CFFFFFF" />
    <!-- The Studio's tasks sidebar: a little deeper than the glass beside it. -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="InnerGlassBrush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="ResponseSurfaceBrush" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="ResponseCodeBrush" Color="#FFEEF2F6" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#21000000" />
    <SolidColorBrush x:Key="GlassBorderSoftBrush" Color="#17000000" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1C000000" />

    <SolidColorBrush x:Key="SubtleGlassBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#14000000" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ActiveContextBrush" Color="#24D9580D" />
    <SolidColorBrush x:Key="RecordingGelBrush" Color="#4D3DBF5C" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B32B9A47" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#66D9580D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#47000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#80000000" />

    <SolidColorBrush x:Key="SuccessOrbBrush" Color="#2EA44F" />
    <SolidColorBrush x:Key="ErrorOrbBrush" Color="#D73A49" />
    <SolidColorBrush x:Key="BusyOrbBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="IdleOrbBrush" Color="#8C98A4" />
</ResourceDictionary>
