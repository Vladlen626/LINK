<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="InkColor">#193849</Color>
    <Color x:Key="MutedInkColor">#6A8492</Color>
    <Color x:Key="SkyColor">#68C7F3</Color>
    <Color x:Key="AquaColor">#72DDE0</Color>
    <Color x:Key="GreenColor">#79D889</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedInkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="AquaBrush" Color="{StaticResource AquaColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFF1F8FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#70F7FCFE" />
    <SolidColorBrush x:Key="ResponseSurfaceBrush" Color="#F4F7FCFE" />
    <SolidColorBrush x:Key="ResponseCodeBrush" Color="#DDE8F1F5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#78FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#C8FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderSoftBrush" Color="#68FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4772A9BD" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#B445BCE9" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#C251C875" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D9485F" />

    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#9CF8FDFF" />
        <GradientStop Offset="0.52" Color="#7CEAF6FA" />
        <GradientStop Offset="1" Color="#74CCE6F0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InnerGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#A8FFFFFF" />
        <GradientStop Offset="1" Color="#72D9EEF5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SubtleGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#78FFFFFF" />
        <GradientStop Offset="1" Color="#55D4EBF3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentActionBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E9A9EDFA" />
        <GradientStop Offset="0.52" Color="#E772DDE0" />
        <GradientStop Offset="1" Color="#E768C7F3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ActiveContextBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#BDE8FCFF" />
        <GradientStop Offset="1" Color="#AD9EEAF2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#73FFFFFF" />
        <GradientStop Offset="0.62" Color="#18FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
