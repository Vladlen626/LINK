    <Geometry x:Key="SendIconGeometry">M4,12 L20,4 L16,20 L12,13 Z M12,13 L20,4</Geometry>
    <Geometry x:Key="CloseIconGeometry">M7,7 L17,17 M17,7 L7,17</Geometry>
