<UserControl x:Class="Link.Desktop.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop"
             AllowDrop="True" PreviewDragOver="Panel_OnPreviewDragOver" PreviewDrop="Panel_OnPreviewDrop"
             PreviewKeyDown="Panel_OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- A card that wants an answer or a decision: the agent's question, a limit, a choice, a start over. -->
        <Style x:Key="NoticeCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- The rounded box words are written in: the task's goal and the reply. -->
        <Style x:Key="ComposerStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SmallChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
        <Style x:Key="GhostChipStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- A choice in the composer's footer: no box of its own until the pointer is on it, as wide as what it shows. -->
        <Style x:Key="ChipComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="8,4,26,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
        <Style x:Key="FileChipStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="ReadTextStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextBlock.LineHeight" Value="20" />
            <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
        </Style>

        <!-- An agent's answer as formatted Markdown (MarkdownText.Source): selectable, as tall as its text. -->
        <Style x:Key="ReadRichTextStyle" TargetType="RichTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A task in the sidebar: a row with soft corners, lit while the task is the open one. -->
        <Style x:Key="SidebarRowStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Border x:Name="HoverLight" CornerRadius="8" Background="{StaticResource HoverBrush}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLight" Property="Opacity" Value="1" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLight" Property="Background" Value="{StaticResource PressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActiveContextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A usage window: who and which, the bar, how much and when it resets. A click asks the agent anew. -->
        <DataTemplate x:Key="LimitRowTemplate" DataType="{x:Type local:LimitRow}">
            <Button Margin="-6,2,-6,0" Padding="6,2" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButtonStyle}"
                    Click="LimitRow_OnClick" ToolTip="{Binding Hint}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource UsageBarStyle}"
                                 Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Text="{Binding Text}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The thread of a task: the user's words on the right in a bubble, each run of an agent as plain text under its
             name, notes between. -->
        <DataTemplate DataType="{x:Type local:ThreadUser}">
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Padding="14,10" CornerRadius="14,14,4,14" Background="{StaticResource ActiveContextBrush}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                            <Button Margin="-6,4,0,0" Padding="6,1" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                    Click="UserWords_OnClick" Visibility="{Binding ToggleVisibility}">
                                <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding ToggleLabel}" />
                            </Button>
                            <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Carried}"
                                       TextWrapping="Wrap" Visibility="{Binding CarriedVisibility}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,4,4,0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding Time}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadNote}">
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Height="1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource HairlineBrush}" />
                <TextBlock Grid.Column="1" MaxWidth="380" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap">
                    <Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" />
                </TextBlock>
                <Border Grid.Column="2" Height="1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource HairlineBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadTurn}">
            <StackPanel Margin="0,18,0,0">
                <!-- Who worked, in the colour of the specialist's jellyfish; how it ended; the steps a click away. -->
                <WrapPanel>
                    <Control Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Focusable="False"
                             Foreground="{Binding RoleBrush}" Template="{StaticResource LinkGlyphTemplate}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Text="{Binding Who}" TextWrapping="Wrap" ToolTip="{Binding Who}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{Binding OutcomeBrush}" Text="{Binding Outcome}" />
                    <Button Margin="2,0,0,0" Padding="6,1" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                            Click="TurnSteps_OnClick" Visibility="{Binding StepsToggleVisibility}" ToolTip="What the agent did, step by step">
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding StepsLabel}" />
                    </Button>
                </WrapPanel>
                <!-- The agent's words as rows; the tool steps between them folded into a line each, as its own app does. -->
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Steps}" Visibility="{Binding StepsVisibility}">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type local:AgentStepRow}">
                            <TextBlock Margin="0,3" FontSize="13.5" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{Binding Brush}" Text="{Binding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:StepGroup}">
                            <StackPanel>
                                <Button Margin="-6,2,0,2" Padding="6,2" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                        Click="StepGroup_OnClick" ToolTip="The tool calls between the agent's words">
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}" TextWrapping="Wrap" />
                                </Button>
                                <Border Margin="0,2,0,8" CornerRadius="8" Background="{StaticResource InnerGlassBrush}"
                                        Visibility="{Binding RowsVisibility}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Margin="0,6" Background="{StaticResource HairlineBrush}" CornerRadius="1" />
                                        <ItemsControl Grid.Column="1" Margin="10,8" ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,1" FontFamily="Consolas" FontSize="11.5" Foreground="{Binding Brush}"
                                                               Text="{Binding Text}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
                <!-- What the agent does now, while it works. -->
                <Grid Margin="0,8,0,0" Visibility="{Binding CurrentVisibility}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Margin="1,1,9,0" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                    <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Current}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <RichTextBox Margin="0,8,0,0" Style="{StaticResource ReadRichTextStyle}" local:MarkdownText.Source="{Binding Said, Mode=OneWay}"
                             Visibility="{Binding SaidVisibility}" />
                <!-- A page the agent opened on this machine (its link-page block), such as the model's review window to mark changes on. -->
                <ItemsControl Margin="0,12,0,2" ItemsSource="{Binding Pages}" Visibility="{Binding PagesVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,6,0" Padding="10,0,12,0" Style="{StaticResource ChipButtonStyle}" Click="OpenPage_OnClick"
                                        Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBorderBrush}" ToolTip="{Binding Address}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0" FontFamily="Segoe UI Symbol" Text="&#x2197;" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,0" Padding="10,0,12,0" Click="PageReply_OnClick" Content="{Binding Reply.Label}" ToolTip="{Binding Reply.Text}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Reply}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- The pictures the run made: an artist's renders and screenshots, as they come; a click opens one. -->
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Images}" Visibility="{Binding ImagesVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,8" Padding="0" Style="{StaticResource GhostButtonStyle}" Click="OpenFile_OnClick"
                                    ToolTip="{Binding Path}" Visibility="{Binding Visibility}">
                                <Border BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="6">
                                    <Image Height="110" MaxWidth="360" Margin="2" Source="{Binding Picture}" Stretch="Uniform" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="-6,8,0,0" Padding="6,1" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                        Click="TurnFiles_OnClick" Visibility="{Binding FilesToggleVisibility}" ToolTip="The files this run changed">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding FilesLabel}" />
                </Button>
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Files}" Visibility="{Binding FilesVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FileChipStyle}" Click="OpenFile_OnClick" ToolTip="{Binding Path}">
                                <TextBlock MaxWidth="300" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Next}"
                           TextWrapping="Wrap" Visibility="{Binding NextVisibility}" />
                <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Stats}"
                           TextWrapping="Wrap" Visibility="{Binding StatsVisibility}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar: the project's tasks, newest first, always at hand; the agents' usage pinned at its foot. -->
        <Border x:Name="Sidebar" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="NewTaskButton" Margin="10,10,10,0" Height="34" Padding="10,0" HorizontalContentAlignment="Left"
                        Style="{StaticResource GhostButtonStyle}" Click="NewTask_OnClick"
                        ToolTip="A card for a new task, with what is in Link's input and its chips; nothing runs before Run (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource PlusIconGeometry}"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="New task" />
                    </StackPanel>
                </Button>

                <!-- Search: the rows whose goal or last words have the words; Esc clears it. -->
                <Border x:Name="SearchField" Grid.Row="1" Height="30" Margin="10,8,10,2" CornerRadius="8" BorderThickness="1"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSoftBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Width="12" Height="12" Margin="10,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource SearchIconGeometry}"
                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Padding="0,0,8,0" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="12.5"
                                 Style="{StaticResource BareTextBoxStyle}" TextChanged="SearchBox_OnTextChanged" PreviewKeyDown="SearchBox_OnPreviewKeyDown" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" IsHitTestVisible="False"
                                   Foreground="{StaticResource MutedBrush}" Text="Search tasks" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,4,8">
                        <TextBlock x:Name="TasksEmptyText" Margin="10,12,6,0" FontSize="12" Style="{StaticResource RowTextStyle}" Foreground="{StaticResource MutedBrush}"
                                   Text="No tasks yet. Write one in Link and press Ctrl+Enter, or choose To ▾ Agent task: a card shows what goes to the agent, and nothing runs before Run." />
                        <TextBlock x:Name="NoMatchText" Margin="10,12,6,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"
                                   Text="No task has these words." />
                        <!-- Groups, each under its line: what needs you, what is at work, the rest. -->
                        <ItemsControl x:Name="TaskList">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:TaskGroupHeader}">
                                    <TextBlock Margin="10,12,6,4" Style="{StaticResource SectionLabelStyle}" FontSize="11.5" Text="{Binding Title}" />
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type local:TaskRow}">
                                    <Button Style="{StaticResource SidebarRowStyle}" Click="TaskRow_OnClick" ToolTip="Open the task: its thread; your words go on with it">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <!-- The specialist's jellyfish, with the task's standing as a dot on its corner. -->
                                            <Grid Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Top">
                                                <Control Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False"
                                                         Foreground="{Binding RoleBrush}" Template="{StaticResource LinkGlyphTemplate}" />
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{Binding StatusBrush}"
                                                         Stroke="{StaticResource WindowSurfaceBrush}" StrokeThickness="1.5" />
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Margin="8,1,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Time}" />
                                                </Grid>
                                                <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Status}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Preview}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Where its tokens went, as long as its share of the costliest task's. -->
                                                <local:SpendBar Height="3" Margin="0,6,0,1" Gap="1" Parts="{Binding Spend}" Scale="{Binding SpendScale}"
                                                                Visibility="{Binding SpendVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- The agents' usage, as the account area at the foot of a chat app's sidebar. -->
                <Border x:Name="LimitsBlock" Grid.Row="3" Padding="12,6,12,8" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="LimitsList" ItemTemplate="{StaticResource LimitRowTemplate}" />
                        <!-- What the agents spent at API prices, as ccusage reads their logs; a click counts again. -->
                        <Button x:Name="SpentButton" Margin="-6,2,-6,0" Padding="6,2" HorizontalContentAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                Click="Spent_OnClick" Visibility="Collapsed">
                            <TextBlock x:Name="SpentText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Nothing open: the way to a task. -->
        <Grid x:Name="EmptyView" Grid.Column="1">
            <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Control Width="48" Height="48" HorizontalAlignment="Center" Focusable="False" Opacity="0.8"
                         Foreground="{StaticResource BrandBrush}" Template="{StaticResource LinkGlyphTemplate}" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="No task open" />
                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="13" Style="{StaticResource SecondaryTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" Text="Pick a task on the left, or start a new one" />
                <Button Margin="0,18,0,0" Padding="18,0" Height="32" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewTask_OnClick" Content="New task" />
                <!-- The Studio's keys, where a first look finds them. -->
                <Grid Margin="0,26,0,0" HorizontalAlignment="Center" TextBlock.FontSize="12" TextBlock.Foreground="{StaticResource MutedBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Border Style="{StaticResource KeyCapStyle}" Margin="0,0,10,6" HorizontalAlignment="Right"><TextBlock Text="Ctrl+N" /></Border>
                    <TextBlock Grid.Column="1" Margin="0,1,0,6" Text="New task" />
                    <Border Grid.Row="1" Style="{StaticResource KeyCapStyle}" Margin="0,0,10,6" HorizontalAlignment="Right"><TextBlock Text="Ctrl+B" /></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,1,0,6" Text="Show or fold the tasks" />
                    <Border Grid.Row="2" Style="{StaticResource KeyCapStyle}" Margin="0,0,10,6" HorizontalAlignment="Right"><TextBlock Text="Ctrl+Shift+U" /></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1,0,6" Text="Spend: where the tokens went" />
                    <Border Grid.Row="3" Style="{StaticResource KeyCapStyle}" Margin="0,0,10,0" HorizontalAlignment="Right"><TextBlock Text="Ctrl+Shift+H" /></Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,1,0,0" Text="Harness: what the agent gets" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- The task card: nothing runs before Run. Also the card a hand-over shows its brief on. -->
        <ScrollViewer x:Name="CardView" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">
            <StackPanel MaxWidth="780" Margin="24,22,24,28">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CardTitleText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="New task" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Margin="12,0,-8,0" Style="{StaticResource GhostChipStyle}" Click="CancelCard_OnClick" Content="Cancel"
                            ToolTip="Close the card: nothing runs" />
                </Grid>
                <!-- Why the card starts on the other agent: the default one has reached its limit. -->
                <TextBlock x:Name="CardNoticeText" Margin="0,8,0,0" FontSize="12.5" Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- The goal as in a chat's box: what goes along above the words, who works and how under them, Run at the end. -->
                <Border Style="{StaticResource ComposerStyle}" Margin="0,12,0,0" Padding="14,10,10,10">
                    <StackPanel>
                        <!-- The images that go along: the screen and pictures from the chips; then what was pasted or dropped. -->
                        <WrapPanel x:Name="ImagesPanel" Margin="0,0,0,4" />
                        <WrapPanel x:Name="CardAttachedPanel" Margin="0,0,0,4" Visibility="Collapsed" />
                        <TextBox x:Name="GoalBox" Style="{StaticResource BareTextBoxStyle}" Padding="0,2" FontSize="13.5" MinHeight="96"
                                 MaxHeight="300" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 LostFocus="Goal_OnLostFocus" PreviewKeyDown="Goal_OnPreviewKeyDown"
                                 ToolTip="What the agent is told, word for word: its first line names the task. Edit it before Run (Ctrl+Enter runs). Ctrl+V or drop adds pictures and files" />
                        <!-- The setup: who works, on what, how hard, with what leave. -->
                        <Grid Margin="-6,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <ComboBox x:Name="ProviderCombo" Style="{StaticResource ChipComboStyle}" SelectionChanged="Provider_OnChanged"
                                          ToolTip="The agent that works on the task" />
                                <ComboBox x:Name="ModelCombo" Style="{StaticResource ChipComboStyle}" SelectionChanged="Model_OnChanged"
                                          ToolTip="The agent's own models: its default from its settings, or one for this task" />
                                <ComboBox x:Name="EffortCombo" Style="{StaticResource ChipComboStyle}"
                                          ToolTip="How long the model thinks: the levels this model takes. Higher spends more of the usage limits. Auto: Link picks it for each run and says why" />
                                <ComboBox x:Name="AccessCombo" Style="{StaticResource ChipComboStyle}" SelectionChanged="Card_OnChanged"
                                          ToolTip="What the agent may do without asking">
                                    <ComboBoxItem Content="Edit — asks for commands"
                                                  ToolTip="The agent changes files and asks before it runs a command" />
                                    <ComboBoxItem Content="Auto — asks nothing"
                                                  ToolTip="Edits and runs commands without asking; the agent's own review stops risky actions: Claude Code's auto mode, Codex's automatic review" />
                                </ComboBox>
                            </WrapPanel>
                            <TextBlock Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                       FontSize="11.5" Text="Ctrl+Enter" />
                            <Button x:Name="RunButton" Grid.Column="2" Height="30" Padding="16,0" VerticalAlignment="Bottom"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="Run_OnClick" Content="Run" ToolTipService.ShowOnDisabled="True" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CardWarningText" Margin="2,8,0,0" FontSize="12.5" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="AttachmentsText" Margin="2,6,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />

                <!-- How the run goes: each choice a pill, its whole meaning under the pointer. -->
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox x:Name="PlanFirstBox" Style="{StaticResource ToggleChipStyle}" Checked="Card_OnChanged" Unchecked="Card_OnChanged" Content="Plan first" />
                    <CheckBox x:Name="NoStopBox" Style="{StaticResource ToggleChipStyle}" Checked="Card_OnChanged" Unchecked="Card_OnChanged" Content="No-stop"
                              ToolTip="It takes the choices it recommends and asks for nothing. Every stop (a question, the plan, a refused tool, the next step) is taken after 10 s; only the deny list of Settings stays refused. It waits for you after the turns of Settings in a row; untick it on the task to step in" />
                    <CheckBox x:Name="TeamBox" Style="{StaticResource ToggleChipStyle}" Checked="Card_OnChanged" Unchecked="Card_OnChanged" Click="TeamBox_OnClick"
                              Content="Team" Visibility="Collapsed"
                              ToolTip="The lead plans the steps, Link gives each to its worker; pays off from about 4 steps. Strong plans first; you see each step with its worker and why, then run the team. Steps run one after another. With fewer steps the plan, briefs and reviews cost more than the cheaper workers save: one agent does it for less" />
                </WrapPanel>
                <ItemsControl x:Name="CardLimitsList" Margin="0,4,0,0" ItemTemplate="{StaticResource LimitRowTemplate}" />

                <!-- The specialist Link picks from the goal, and the skills that go with it: both can be changed. -->
                <StackPanel x:Name="RoleRow" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Specialist" />
                    <WrapPanel x:Name="RolesPanel" Margin="0,-6,0,0" />
                    <TextBlock x:Name="RolePickText" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="Picked by Link from your words: change it if it does not fit" />
                </StackPanel>
                <StackPanel x:Name="SkillsRow" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Skills" ToolTip="Skills of the workspace the agent is told to read first" />
                    <WrapPanel x:Name="SkillsPanel" Margin="0,-6,0,0" />
                </StackPanel>

                <!-- Where, with what else: muted, below the setup. -->
                <Border Margin="0,18,0,0" Padding="0,12,0,0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12" Text="Project" />
                            <TextBlock x:Name="ProjectText" Grid.Column="1" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" FontSize="12" Text="Workspace" />
                            <TextBlock x:Name="WorkspaceText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" VerticalAlignment="Center" FontSize="12"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <!-- The folder the agent works in, chosen here rather than in the Project tab: Run waits for it. -->
                            <Button x:Name="ChooseWorkspaceButton" Grid.Row="1" Grid.Column="2" Margin="8,4,-6,0" Padding="8,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" Click="ChooseWorkspace_OnClick"
                                    ToolTip="The folder of the project's work: the agent reads and edits there. The project keeps it">
                                <TextBlock FontSize="12" Foreground="{StaticResource LinkTextBrush}" Text="Choose folder…" />
                            </Button>
                        </Grid>
                        <!-- What else goes with the run, and the way to the Studio's inspector, which lists it all. -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="HarnessLineText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" FontSize="12"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CardHarnessButton" Grid.Column="1" Margin="8,0,-6,0" Padding="8,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" Click="CardHarness_OnClick"
                                    ToolTip="Open the Harness column of the Studio: the rules, role, memory, skills, tools and check this run gets (Ctrl+Shift+H)">
                                <TextBlock FontSize="12" Foreground="{StaticResource LinkTextBrush}" Text="Harness ›" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="CheckText" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- A task: its header, its thread, and the box for the next words to the agent. -->
        <Grid x:Name="TaskView" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel MaxWidth="780" Margin="24,16,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GoalText" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="9,3" VerticalAlignment="Center" CornerRadius="11"
                            Background="{StaticResource SubtleGlassBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="ChangesText" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <!-- The last run's diff, line by line, with comments that go back to the agent. -->
                    <Button x:Name="ReviewButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="28" Margin="8,0,0,0"
                            Click="Review_OnClick" Content="Review" Visibility="Collapsed"
                            ToolTip="The last run's changes, line by line: comment on any line and send the comments to the agent" />
                    <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource ChipButtonStyle}" Height="28" Margin="8,0,0,0"
                            Click="Stop_OnClick" Content="■ Stop" ToolTip="Stop the agent now; what it changed so far stays, and the task stays open" />
                    <Button x:Name="MoreButton" Grid.Column="4" Style="{StaticResource HeaderIconButtonStyle}" Margin="4,0,-4,0"
                            VerticalAlignment="Center" Click="More_OnClick" ToolTip="More: discuss in chat, undo, start over, console…">
                        <TextBlock Margin="0,-4,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="⋯" />
                    </Button>
                </Grid>
                <!-- Who works, on what, with what access and for how long; and where. -->
                <TextBlock x:Name="HeaderText" Margin="0,4,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WhereText" Margin="0,1,0,0" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                <!-- The agent's own plan, or the team's, as it last stood. -->
                <Border x:Name="PlanCard" Margin="0,12,0,0" Padding="12,5,12,8" CornerRadius="10" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="PlanToggle" Margin="-6,0,0,0" Padding="6,3" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                Click="PlanToggle_OnClick">
                            <TextBlock x:Name="PlanLabel" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </Button>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PlanList" Margin="0,2,4,0">
                                <ItemsControl.ItemTemplate>
                                    <!-- A step on one line, its first sentence; a click opens the rest and why its worker. -->
                                    <DataTemplate>
                                        <StackPanel>
                                            <Button Margin="-6,0,0,0" Padding="6,3" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButtonStyle}"
                                                    Click="PlanRow_OnClick">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="14" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="13" Foreground="{Binding MarkBrush}" Text="{Binding Mark}" />
                                                    <TextBlock Grid.Column="1" FontSize="13" Foreground="{Binding Brush}" Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- A team's step: who does it, and as which specialist. -->
                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <!-- The worker chip opens the step's menu: another worker, again, skip, back, re-plan. -->
                                                        <Button Margin="0,0,8,0" Padding="0" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                                                                Visibility="{Binding WorkerVisibility}" Click="PlanWorker_OnClick"
                                                                ToolTip="Change who does this step, run it again, skip it, go back to it, or re-plan the steps left">
                                                            <Border Padding="6,1" CornerRadius="6" Background="{StaticResource SubtleGlassBrush}">
                                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Worker}" />
                                                            </Border>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding RoleVisibility}">
                                                            <Control Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Focusable="False"
                                                                     Foreground="{Binding RoleBrush}" Template="{StaticResource LinkGlyphTemplate}" />
                                                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{Binding RoleBrush}" Text="{Binding RoleName}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" Text="{Binding Chevron}" />
                                                </Grid>
                                            </Button>
                                            <TextBlock Margin="20,0,14,8" FontSize="12.5" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{StaticResource MutedBrush}" Text="{Binding Detail}" TextWrapping="Wrap"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="ThreadScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="780" Margin="24,0,24,12">
                    <ItemsControl x:Name="ThreadList" />

                    <!-- The agent asks: its options as buttons, as its own app shows them; words of your own go below. -->
                    <Border x:Name="QuestionCard" Style="{StaticResource NoticeCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="QuestionText" Style="{StaticResource RowTextStyle}" FontWeight="SemiBold" />
                            <StackPanel x:Name="OptionsPanel" Margin="0,8,0,0" />
                            <Button x:Name="SendChoicesButton" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,10,0,0" Padding="14,0"
                                    HorizontalAlignment="Left" Click="SendChoices_OnClick" Content="Send" Visibility="Collapsed" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="Or answer in your own words below." />
                        </StackPanel>
                    </Border>

                    <!-- A usage limit near or reached: the ways on are offered; going on by itself after the reset is a box to untick. -->
                    <Border x:Name="LimitCard" Style="{StaticResource NoticeCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LimitText" Style="{StaticResource RowTextStyle}" />
                            <CheckBox x:Name="LimitBox" Margin="0,8,0,0" FontSize="12.5" Visibility="Collapsed" Click="LimitBox_OnClick" />
                            <WrapPanel x:Name="LimitActions" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- A decision only the user can make: a tool the running agent asks for, allow and retry, retry with
                         edits, or carry out the plan. -->
                    <Border x:Name="DecisionCard" Style="{StaticResource NoticeCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DecisionText" Style="{StaticResource RowTextStyle}" />
                            <CheckBox x:Name="AlwaysBox" Margin="0,8,0,0" FontSize="12.5" Content="Always allow for this project" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="DecisionButton" Style="{StaticResource PrimaryButtonStyle}" Height="30"
                                        Padding="14,0" Click="Decision_OnClick" />
                                <Button x:Name="DenyButton" Style="{StaticResource SmallChipStyle}" Height="30" Margin="6,0,0,0"
                                        Content="Deny" Visibility="Collapsed" Click="Deny_OnClick"
                                        ToolTip="The agent goes on without it" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- After a failed run or a Stop on a loop: start over with a note, or the same session on Deep. -->
                    <Border x:Name="RestartCard" Style="{StaticResource NoticeCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTextStyle}" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                       Text="Start over: the agent writes in five lines what it tried and why it did not work, and a new session takes the task with that note. Escalate: the same session goes on with the strongest model of Settings." />
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,6,6,0" Padding="14,0"
                                        Click="Restart_OnClick" Content="Start over with a note" />
                                <Button x:Name="EscalateButton" Style="{StaticResource SmallChipStyle}" Height="28" Click="Escalate_OnClick" Content="Escalate" />
                                <Button Style="{StaticResource SmallChipStyle}" Height="28" Click="RestartNotNow_OnClick" Content="Not now"
                                        ToolTip="The agent goes on as it is; both stay possible after the run" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UsageText" Margin="0,16,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Words for the agent. While it works: Steer now (Enter) or words for after this step (Tab); after it: a reply.
                 The task's buttons sit in the box, under the words, when the task is at rest. -->
            <Border x:Name="ReplyPanel" Grid.Row="2" MaxWidth="780" Margin="24,6,24,16" Style="{StaticResource ComposerStyle}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <!-- Pictures and files pasted (Ctrl+V) or dropped, to go with the words. -->
                    <WrapPanel x:Name="ReplyAttachedPanel" Margin="0,0,0,6" Visibility="Collapsed" />
                    <Grid x:Name="ReplyEditor" Grid.Row="1">
                        <TextBox x:Name="ReplyBox" Style="{StaticResource BareTextBoxStyle}" Padding="0,2" FontSize="13.5" MinHeight="44" MaxHeight="180"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 TextChanged="ReplyBox_OnTextChanged" PreviewKeyDown="ReplyBox_OnPreviewKeyDown" />
                        <TextBlock x:Name="ReplyPlaceholder" Margin="2,2,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="13"
                                   IsHitTestVisible="False" TextWrapping="Wrap" />
                    </Grid>
                    <Grid x:Name="ComposerFooter" Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="TaskButtons" VerticalAlignment="Center">
                            <Button x:Name="PlanModeButton" Style="{StaticResource GhostChipStyle}" Click="PlanMode_OnClick" Content="Plan mode ✕"
                                    Visibility="Collapsed"
                                    ToolTip="The session only reads and plans: edits, editor calls and commands are refused in it, whatever is allowed. Turn it off: your next words go on with edits, in the same session" />
                            <Button x:Name="ReplanButton" Style="{StaticResource GhostChipStyle}" Click="Replan_OnClick" Content="Re-plan ✕"
                                    Visibility="Collapsed"
                                    ToolTip="Your next words go to the team's lead: the steps done stay, it plans the rest anew. Click to send words as usual" />
                            <Button x:Name="HandOffButton" Style="{StaticResource GhostChipStyle}" Click="HandOff_OnClick" Content="Hand off ▾"
                                    ToolTip="The other agent in a new session with a brief you see first, or the first agent back in its own session" />
                            <Button x:Name="FinishButton" Style="{StaticResource GhostChipStyle}" Click="Finish_OnClick" Content="Finish"
                                    ToolTip="Close the task; it stays in the list, where it can be opened and taken up again" />
                        </WrapPanel>
                        <!-- No-stop for this task, also while it works; its label shows the choice it is about to take. -->
                        <CheckBox x:Name="NoStopLiveBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                  Click="NoStopLiveBox_OnClick" Visibility="Collapsed" />
                        <!-- What the next words run on; nothing starts when it changes. -->
                        <Button x:Name="SetupButton" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource GhostChipStyle}"
                                Click="Setup_OnClick" Visibility="Collapsed"
                                ToolTip="What your next words run on: the specialist, the model and its effort. Nothing starts when you change it; the runs after keep it" />
                        <Button x:Name="ContinueButton" Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource ComposerSendButtonStyle}"
                                VerticalAlignment="Bottom" Click="Continue_OnClick" IsEnabled="False">
                            <Viewbox Width="14" Height="14">
                                <Path Data="{StaticResource ArrowUpIconGeometry}" Stroke="{StaticResource AccentForegroundBrush}"
                                      StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="ReplyNoteText" Grid.Row="3" MaxWidth="780" Margin="24,0,24,14" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
