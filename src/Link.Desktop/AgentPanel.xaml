<UserControl x:Class="Link.Desktop.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="FieldStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
        </Style>
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SmallChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
        <Style x:Key="ReadTextStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- A usage window: who and which, the bar, how much and when it resets. A click asks the agent anew. -->
        <DataTemplate x:Key="LimitRowTemplate" DataType="{x:Type local:LimitRow}">
            <Button Margin="-6,2,-6,0" Padding="6,2" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButtonStyle}"
                    Click="LimitRow_OnClick" ToolTip="{Binding Hint}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource UsageBarStyle}"
                                 Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Brush}" />
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Text="{Binding Text}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- The thread of a task: the user's words on the right, each run of an agent on the left, notes between. -->
        <DataTemplate DataType="{x:Type local:ThreadUser}">
            <Border Margin="36,10,0,0" HorizontalAlignment="Right" Padding="10,7" CornerRadius="10,10,3,10"
                    Background="{StaticResource ActiveContextBrush}">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Carried}"
                               TextWrapping="Wrap" Visibility="{Binding CarriedVisibility}" />
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding Time}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadNote}">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Height="1" Margin="0,0,8,0" VerticalAlignment="Center" Background="{StaticResource HairlineBrush}" />
                <TextBlock Grid.Column="1" MaxWidth="260" FontSize="11" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap">
                    <Run Text="{Binding Text, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Time, Mode=OneWay}" />
                </TextBlock>
                <Border Grid.Column="2" Height="1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{StaticResource HairlineBrush}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadTurn}">
            <Border Margin="0,10,20,0" Padding="10,8" CornerRadius="10,10,10,3" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Who}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Who}" />
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{Binding OutcomeBrush}" Text="{Binding Outcome}" />
                        <Button Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                                Click="TurnSteps_OnClick" Visibility="{Binding StepsToggleVisibility}" ToolTip="What the agent did, step by step">
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding StepsLabel}" />
                        </Button>
                    </StackPanel>
                    <!-- The agent's words as rows; the tool steps between them folded into a line each, as its own app does. -->
                    <ItemsControl Margin="0,1,0,2" ItemsSource="{Binding Steps}" Visibility="{Binding StepsVisibility}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type local:AgentStepRow}">
                                <TextBlock Margin="0,1" FontSize="11.5" Foreground="{Binding Brush}" Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:StepGroup}">
                                <StackPanel>
                                    <Button Margin="-6,0,0,0" Padding="6,1" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                                            Click="StepGroup_OnClick" ToolTip="The tool calls between the agent's words">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}" TextWrapping="Wrap" />
                                    </Button>
                                    <ItemsControl Margin="8,0,0,0" ItemsSource="{Binding Rows}" Visibility="{Binding RowsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1" FontSize="11.5" Foreground="{Binding Brush}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                    <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Current}"
                               TextTrimming="CharacterEllipsis" Visibility="{Binding CurrentVisibility}" />
                    <TextBox Margin="0,5,0,0" Style="{StaticResource ReadTextStyle}" Text="{Binding Said, Mode=OneWay}"
                             Visibility="{Binding SaidVisibility}" />
                    <ItemsControl Margin="-6,5,0,0" ItemsSource="{Binding Files}" Visibility="{Binding FilesVisibility}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Padding="6,2" Style="{StaticResource GhostButtonStyle}" Click="OpenFile_OnClick" ToolTip="{Binding Path}">
                                    <TextBlock MaxWidth="240" FontFamily="Consolas" FontSize="11" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Next}"
                               TextWrapping="Wrap" Visibility="{Binding NextVisibility}" />
                    <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Stats}"
                               TextWrapping="Wrap" Visibility="{Binding StatsVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The project's tasks, newest first, with the agents' usage on top. -->
        <Grid x:Name="ListView">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="TASKS" />
                <Button x:Name="NewTaskButton" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Height="26" Click="NewTask_OnClick"
                        ToolTip="A card for a new task, with what is in Link's input and its chips; nothing runs before Run (Ctrl+Enter in Link)">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource PlusIconGeometry}"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock VerticalAlignment="Center" Text="New task" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsControl x:Name="LimitsList" Grid.Row="1" Margin="0,8,0,4" ItemTemplate="{StaticResource LimitRowTemplate}" />
            <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock x:Name="TasksEmptyText" Margin="0,6,0,0" Style="{StaticResource RowTextStyle}" Foreground="{StaticResource MutedBrush}"
                               Text="No tasks yet. Write one in Link and press Ctrl+Enter, or choose To ▾ Agent task: a card shows what goes to the agent, and nothing runs before Run." />
                    <ItemsControl x:Name="TaskList" Margin="-8,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,2" Padding="8,6" HorizontalContentAlignment="Stretch" Style="{StaticResource GhostButtonStyle}"
                                        Click="TaskRow_OnClick" ToolTip="Open the task: its thread; your words go on with it">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Margin="0,5,9,0" VerticalAlignment="Top" Fill="{Binding StatusBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Text="{Binding Time}" />
                                            </Grid>
                                            <TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{Binding StatusBrush}" Text="{Binding Status}" />
                                            <TextBlock Margin="0,2,0,0" MaxHeight="32" FontSize="11.5" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{StaticResource MutedBrush}" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The task card: nothing runs before Run. Also the card a hand-over shows its brief on. -->
        <ScrollViewer x:Name="CardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel Margin="0,0,4,0">
                <TextBlock x:Name="CardTitleText" Style="{StaticResource SectionLabelStyle}" Text="NEW TASK" />
                <Border Style="{StaticResource FieldStyle}">
                    <TextBox x:Name="GoalBox" Style="{StaticResource BareTextBoxStyle}" Padding="4,4" FontSize="12.5" MinHeight="60"
                             MaxHeight="260" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             LostFocus="Goal_OnLostFocus"
                             ToolTip="What the agent is told, word for word: its first line names the task. Edit it before Run" />
                </Border>
                <!-- The images that go along: the screen and pictures from the chips. -->
                <WrapPanel x:Name="ImagesPanel" Margin="0,6,0,0" />
                <TextBlock x:Name="AttachmentsText" Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Agent" />
                    <ComboBox x:Name="ProviderCombo" Grid.Column="1" SelectionChanged="Provider_OnChanged" />
                    <ItemsControl x:Name="CardLimitsList" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" ItemTemplate="{StaticResource LimitRowTemplate}" />
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Model" />
                    <ComboBox x:Name="ModelCombo" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Model_OnChanged"
                              ToolTip="The agent's own models: its default from its settings, or one for this task" />
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Effort" />
                    <ComboBox x:Name="EffortCombo" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" ToolTipService.ShowOnDisabled="True"
                              ToolTip="How long the model thinks: the levels this model takes. Higher spends more of the usage limits. Auto: Link picks it for each run and says why" />
                    <TextBlock Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Access" />
                    <ComboBox x:Name="AccessCombo" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Card_OnChanged">
                        <ComboBoxItem Content="Edit — changes files, asks for commands" />
                        <ComboBoxItem Content="Auto — edits and runs commands, asks nothing"
                                      ToolTip="The agent's own review stops risky actions: Claude Code's auto mode, Codex's automatic review" />
                    </ComboBox>
                    <!-- The specialist Link picks from the goal, and the skills that go with it: both can be changed. -->
                    <Grid x:Name="RoleRow" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Specialist" />
                        <ComboBox x:Name="RoleCombo" Grid.Column="1" SelectionChanged="Role_OnChanged" />
                        <TextBlock x:Name="RolePickText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Style="{StaticResource SecondaryTextStyle}"
                                   FontSize="11" TextWrapping="Wrap" Text="Picked by Link from your words: change it if it does not fit" />
                    </Grid>
                    <Grid x:Name="SkillsRow" Grid.Row="6" Grid.ColumnSpan="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Margin="0,12,0,0" VerticalAlignment="Top" Style="{StaticResource SecondaryTextStyle}" Text="Skills"
                                   ToolTip="Skills of the workspace the agent is told to read first" />
                        <WrapPanel x:Name="SkillsPanel" Grid.Column="1" />
                    </Grid>
                    <TextBlock Grid.Row="7" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Project" />
                    <TextBlock x:Name="ProjectText" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource RowTextStyle}" />
                    <TextBlock Grid.Row="8" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Workspace" />
                    <TextBlock x:Name="WorkspaceText" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource RowTextStyle}" />
                </Grid>

                <CheckBox x:Name="PlanFirstBox" Margin="0,10,0,0" Checked="Card_OnChanged" Unchecked="Card_OnChanged" />
                <CheckBox x:Name="BackupBox" Margin="0,6,0,0" IsChecked="True" Content="Copy the folder before edits"
                          ToolTip="The workspace has no Git or Perforce: undo puts the files back from this copy" />
                <TextBlock x:Name="CheckText" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="CardWarningText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,6,6,0" Padding="14,0"
                            Click="Run_OnClick" Content="Run" />
                    <Button Style="{StaticResource SmallChipStyle}" Click="CancelCard_OnClick" Content="Cancel" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- A task: its header, its thread, and the box for the next words to the agent. -->
        <Grid x:Name="TaskView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource HeaderIconButtonStyle}" Margin="-6,0,2,0" VerticalAlignment="Center" Click="Back_OnClick"
                            ToolTip="All tasks of the project">
                        <Path Width="9" Height="12" Stretch="Uniform" Data="{StaticResource BackIconGeometry}" Stroke="{StaticResource TextBrush}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <TextBlock x:Name="GoalText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="7,2" VerticalAlignment="Center" CornerRadius="9"
                            Background="{StaticResource SubtleGlassBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="ChangesText" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource ChipButtonStyle}" Height="24" Margin="6,0,0,0"
                            Click="Stop_OnClick" Content="■ Stop" ToolTip="Stop the agent now; what it changed so far stays, and the task stays open" />
                    <Button x:Name="MoreButton" Grid.Column="4" Style="{StaticResource HeaderIconButtonStyle}" Margin="4,0,-4,0"
                            VerticalAlignment="Center" Click="More_OnClick" ToolTip="More: discuss in chat, undo, start over, console…">
                        <TextBlock Margin="0,-4,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="⋯" />
                    </Button>
                </Grid>
                <TextBlock x:Name="HeaderText" Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WhereText" Margin="0,1,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <!-- The agent's own plan, as it last wrote it. -->
                <Button x:Name="PlanToggle" Margin="-8,6,0,0" Padding="8,2" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                        Click="PlanToggle_OnClick" Visibility="Collapsed">
                    <TextBlock x:Name="PlanLabel" Style="{StaticResource SectionLabelStyle}" />
                </Button>
                <ItemsControl x:Name="PlanList" Margin="0,1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" Foreground="{Binding Brush}" Text="{Binding Mark}" />
                                <TextBlock Grid.Column="1" FontSize="12" Foreground="{Binding Brush}" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ScrollViewer x:Name="ThreadScroll" Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,8">
                    <ItemsControl x:Name="ThreadList" />

                    <!-- The agent asks: its options as buttons, as its own app shows them; words of your own go below. -->
                    <Border x:Name="QuestionCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,9"
                            BorderBrush="{StaticResource AccentBorderBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="QuestionText" Style="{StaticResource RowTextStyle}" FontWeight="SemiBold" />
                            <StackPanel x:Name="OptionsPanel" Margin="0,6,0,0" />
                            <Button x:Name="SendChoicesButton" Style="{StaticResource PrimaryButtonStyle}" Height="26" Margin="0,8,0,0" Padding="12,0"
                                    HorizontalAlignment="Left" Click="SendChoices_OnClick" Content="Send" Visibility="Collapsed" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                                       Text="Or answer in your own words below." />
                        </StackPanel>
                    </Border>

                    <!-- A usage limit near or reached: the ways on are offered, nothing is done by itself. -->
                    <Border x:Name="LimitCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,8"
                            BorderBrush="{StaticResource AccentBorderBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="LimitText" Style="{StaticResource RowTextStyle}" />
                            <WrapPanel x:Name="LimitActions" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- A decision only the user can make: allow and retry, retry with edits, or carry out the plan. -->
                    <Border x:Name="DecisionCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,8"
                            BorderBrush="{StaticResource AccentBorderBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DecisionText" Style="{StaticResource RowTextStyle}" />
                            <CheckBox x:Name="AlwaysBox" Margin="0,6,0,0" Content="Always allow for this project" />
                            <Button x:Name="DecisionButton" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,8,0,0"
                                    Padding="14,0" HorizontalAlignment="Left" Click="Decision_OnClick" />
                        </StackPanel>
                    </Border>

                    <!-- After a failed run or a Stop on a loop: start over with a note, or the same session on Deep. -->
                    <Border x:Name="RestartCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTextStyle}" Foreground="{StaticResource MutedBrush}"
                                       Text="Start over: the agent writes in five lines what it tried and why it did not work, and a new session takes the task with that note. Escalate: the same session goes on with the strongest model of Settings." />
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,6,6,0" Padding="14,0"
                                        Click="Restart_OnClick" Content="Start over with a note" />
                                <Button x:Name="EscalateButton" Style="{StaticResource SmallChipStyle}" Click="Escalate_OnClick" Content="Escalate" />
                                <Button Style="{StaticResource SmallChipStyle}" Click="RestartNotNow_OnClick" Content="Not now"
                                        ToolTip="The agent goes on as it is; both stay possible after the run" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- What Link gave the agent, word for word; the Console has the rest. -->
                    <Button x:Name="BriefToggle" Margin="-8,12,0,0" Padding="8,2" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                            Click="BriefToggle_OnClick" Visibility="Collapsed"
                            ToolTip="The text Link gave the agent for this task: the brief, and each hand-over after it">
                        <TextBlock x:Name="BriefToggleText" Style="{StaticResource SectionLabelStyle}" Text="WHAT LINK GAVE ▸" />
                    </Button>
                    <TextBox x:Name="BriefText" Margin="0,2,0,0" Style="{StaticResource BareTextBoxStyle}" FontFamily="Consolas" FontSize="11.5"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
                    <TextBlock x:Name="UsageText" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- Words for the agent. While it works: a correction (Enter) or words for after this run (Tab); after it: a reply. -->
            <Border x:Name="ReplyPanel" Grid.Row="2" Style="{StaticResource FieldStyle}" Margin="0,6,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplyBox" Style="{StaticResource BareTextBoxStyle}" Padding="4,4" FontSize="12.5" MaxHeight="120"
                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="ReplyBox_OnTextChanged" PreviewKeyDown="ReplyBox_OnPreviewKeyDown" />
                    <TextBlock x:Name="ReplyPlaceholder" Margin="6,5,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="12"
                               IsHitTestVisible="False" TextWrapping="Wrap" />
                    <Button x:Name="ContinueButton" Grid.Column="1" Style="{StaticResource SmallChipStyle}" Margin="6,3,3,3"
                            VerticalAlignment="Bottom" Click="Continue_OnClick" />
                </Grid>
            </Border>
            <TextBlock x:Name="ReplyNoteText" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Grid.Row="3">
                <WrapPanel x:Name="TaskButtons">
                    <Button x:Name="PlanModeButton" Style="{StaticResource SmallChipStyle}" Click="PlanMode_OnClick" Content="Plan mode ✕"
                            Visibility="Collapsed"
                            ToolTip="The session only reads and plans: edits, editor calls and commands are refused in it, whatever is allowed. Turn it off: your next words go on with edits, in the same session" />
                    <Button x:Name="HandOffButton" Style="{StaticResource SmallChipStyle}" Click="HandOff_OnClick" Content="Hand off ▾"
                            ToolTip="The other agent in a new session with a brief you see first, another model or another specialist in the same session, or the first agent back" />
                    <Button x:Name="FinishButton" Style="{StaticResource SmallChipStyle}" Click="Finish_OnClick" Content="Finish"
                            ToolTip="Close the task; it stays in the list, where it can be opened and taken up again" />
                </WrapPanel>
                <ItemsControl x:Name="TaskLimitsList" Margin="0,4,0,0" ItemTemplate="{StaticResource LimitRowTemplate}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
