<UserControl x:Class="Link.Desktop.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
        </Style>
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SmallChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The confirmation card: nothing runs before Run. -->
        <ScrollViewer x:Name="CardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="GOAL" />
                <Border Style="{StaticResource FieldStyle}">
                    <TextBox x:Name="GoalBox" Style="{StaticResource BareTextBoxStyle}" Padding="4,4" FontSize="12.5" MinHeight="60"
                             MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Agent" />
                    <ComboBox x:Name="ProviderCombo" Grid.Column="1" SelectionChanged="Card_OnChanged" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Access" />
                    <ComboBox x:Name="AccessCombo" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="Card_OnChanged">
                        <ComboBoxItem Content="Edit — changes files, asks for commands" />
                        <ComboBoxItem Content="Auto — edits and runs commands, asks nothing"
                                      ToolTip="The agent's own review stops risky actions: Claude Code's auto mode, Codex's automatic review" />
                    </ComboBox>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Effort" />
                    <ComboBox x:Name="EffortCombo" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                              ToolTip="How hard the agent thinks on this task; the choice stays for the agent. Default: the agent's own setting" />
                    <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Project" />
                    <TextBlock x:Name="ProjectText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource RowTextStyle}" />
                    <TextBlock Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Workspace" />
                    <TextBlock x:Name="WorkspaceText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource RowTextStyle}" />
                </Grid>

                <CheckBox x:Name="PlanFirstBox" Margin="0,10,0,0" Content="Plan first: the agent only reads and proposes, then you run it"
                          Checked="Card_OnChanged" Unchecked="Card_OnChanged" />
                <CheckBox x:Name="BackupBox" Margin="0,6,0,0" IsChecked="True"
                          Content="Copy the workspace before edits (it has no git)" />
                <TextBlock x:Name="CheckText" Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="AttachmentsText" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="CardWarningText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,6,6,0" Padding="14,0"
                            Click="Run_OnClick" Content="Run" />
                    <Button Style="{StaticResource SmallChipStyle}" Click="CancelCard_OnClick" Content="Cancel" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Activity: what the agent does, what it changed, how it ended. -->
        <Grid x:Name="ActivityView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderText" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ConsoleButton" Grid.Column="1" Style="{StaticResource ChipButtonStyle}" Height="26" Margin="6,0,0,0"
                            Click="Console_OnClick" Content="Console"
                            ToolTip="What Link gave the agent's CLI (command, folder, the whole text) and every line it writes back, live" />
                    <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="26" Margin="6,0,0,0"
                            Click="Stop_OnClick" Content="■ Stop" ToolTip="Stop the agent now; what it changed so far stays and is listed" />
                </Grid>
                <TextBlock x:Name="WhereText" Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentStepText" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ScrollViewer x:Name="StepsScroll" Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <ItemsControl x:Name="StepsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1" FontSize="11.5" Foreground="{Binding Brush}" Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A decision only the user can make: allow and retry, retry with edits, or carry out the plan. -->
                    <Border x:Name="DecisionCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,8"
                            BorderBrush="{StaticResource AccentBorderBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DecisionText" Style="{StaticResource RowTextStyle}" />
                            <CheckBox x:Name="AlwaysBox" Margin="0,6,0,0" Content="Always allow for this project" />
                            <Button x:Name="DecisionButton" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,8,0,0"
                                    Padding="14,0" HorizontalAlignment="Left" Click="Decision_OnClick" />
                        </StackPanel>
                    </Border>

                    <!-- Start over with a note: beside a loop's label and after a failure. -->
                    <Border x:Name="RestartCard" Style="{StaticResource FieldStyle}" Margin="0,10,0,0" Padding="10,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTextStyle}" Foreground="{StaticResource MutedBrush}"
                                       Text="Start over in a clean session: the agent writes in five lines what it tried and why it did not work, then a new session takes the task with that note, the same access and folder." />
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,6,6,0" Padding="14,0"
                                        Click="Restart_OnClick" Content="Start over with a note" />
                                <Button Style="{StaticResource SmallChipStyle}" Click="RestartNotNow_OnClick" Content="Not now"
                                        ToolTip="The agent goes on as it is; Start over stays possible after the task" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ChangesLabel" Margin="0,12,0,0" Style="{StaticResource SectionLabelStyle}" Text="CHANGED" Visibility="Collapsed" />
                    <ItemsControl x:Name="ChangesList" Margin="-8,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="8,3" HorizontalContentAlignment="Left"
                                        Click="OpenFile_OnClick" ToolTip="{Binding Path}">
                                    <TextBlock FontSize="11.5" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ResultLabel" Margin="0,12,0,0" Style="{StaticResource SectionLabelStyle}" Text="RESULT" Visibility="Collapsed" />
                    <TextBox x:Name="ResultText" Margin="0,4,0,0" Style="{StaticResource BareTextBoxStyle}" FontSize="12.5" IsReadOnly="True"
                             TextWrapping="Wrap" Visibility="Collapsed" />
                    <!-- What the task cost: turns, tool calls, searches, failed calls, tokens. -->
                    <TextBlock x:Name="StatsText" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- A reply to the agent: the same session goes on with it, like a message in its own terminal. -->
            <Border x:Name="ReplyPanel" Grid.Row="2" Style="{StaticResource FieldStyle}" Margin="0,8,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplyBox" Style="{StaticResource BareTextBoxStyle}" Padding="4,4" FontSize="12.5" MaxHeight="120"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             TextChanged="ReplyBox_OnTextChanged" PreviewKeyDown="ReplyBox_OnPreviewKeyDown" />
                    <TextBlock x:Name="ReplyPlaceholder" Margin="6,5,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="12.5" IsHitTestVisible="False"
                               Text="Reply to the agent: answer it or ask for more" />
                    <Button x:Name="ContinueButton" Grid.Column="1" Style="{StaticResource SmallChipStyle}" Margin="6,3,3,3"
                            VerticalAlignment="Bottom" Click="Continue_OnClick" Content="Continue"
                            ToolTip="The same session goes on with your words, with the same access and folder (Enter). While the agent works, it stops first" />
                </Grid>
            </Border>

            <WrapPanel Grid.Row="3" Margin="0,4,0,0">
                <Button x:Name="ToChatButton" Style="{StaticResource SmallChipStyle}" Click="ToChat_OnClick" Content="↻ To chat"
                        ToolTip="Put the result and the changed files into the context for your next Chat message" Visibility="Collapsed" />
                <Button x:Name="UndoButton" Style="{StaticResource SmallChipStyle}" Click="Undo_OnClick" Visibility="Collapsed" />
                <Button x:Name="SaveSkillButton" Style="{StaticResource SmallChipStyle}" Click="SaveSkill_OnClick" Content="Save as skill"
                        ToolTip="The agent describes what it just did as a skill; Link writes it to .agents/skills in the workspace"
                        Visibility="Collapsed" />
                <Button x:Name="HandOffButton" Style="{StaticResource SmallChipStyle}" Click="HandOff_OnClick" Visibility="Collapsed"
                        ToolTip="The other agent takes the task over in a new session of its own: the goal, how this one ended, its last steps and changed files go along, and your reply as a note. For when one runs out of its limit" />
                <Button x:Name="NewTaskButton" Style="{StaticResource SmallChipStyle}" Click="Close_OnClick" Content="Done"
                        ToolTip="Back to the project panel" Visibility="Collapsed" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
