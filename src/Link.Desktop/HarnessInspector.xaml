<UserControl x:Class="Link.Desktop.HarnessInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="SectionNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CardNoteStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Share's buttons: text that looks like what it is, a link. -->
        <Style x:Key="SectionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Margin" Value="2,-3,-6,-3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="SectionLinkTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource LinkTextBrush}" />
        </Style>
        <!-- The context's bar turns to a warning near the limit. -->
        <Style x:Key="ContextMeterStyle" TargetType="ProgressBar" BasedOn="{StaticResource UsageBarStyle}">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MeterHigh}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BusyOrbBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A file or a text a card names: a click opens it in Link's viewer; a role's jellyfish in its colour before it.
             A line with nothing to open only says. -->
        <DataTemplate x:Key="LinkTemplate" DataType="{x:Type local:HarnessLinkRow}">
            <Button Margin="0" Padding="6,4" Style="{StaticResource SidebarRowStyle}" Click="Link_OnClick"
                    IsHitTestVisible="{Binding Opens}" Focusable="{Binding Opens}" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Control Width="13" Height="13" Margin="0,2,6,0" VerticalAlignment="Top" Focusable="False"
                             Foreground="{Binding RoleBrush}" Template="{StaticResource LinkGlyphTemplate}" Visibility="{Binding RoleVisibility}"
                             ToolTip="{Binding Label}" />
                    <TextBlock Grid.Column="1" FontSize="12.5" TextWrapping="Wrap">
                        <Run Text="{Binding Label, Mode=OneWay}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Setter Property="Foreground" Value="{StaticResource LinkTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Opens}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run><Run Foreground="{StaticResource MutedBrush}" Text="{Binding NoteText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A part of the harness: what it is, a note or two, and what opens in the viewer. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:HarnessRow}">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Heading}" />
                    <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource TextBrush}" Text="{Binding Value}" TextWrapping="Wrap" />
                    <ProgressBar Style="{StaticResource ContextMeterStyle}" Value="{Binding MeterPercent, Mode=OneWay}"
                                 Visibility="{Binding MeterVisibility}" />
                    <TextBlock Style="{StaticResource SectionNoteStyle}" Text="{Binding Note}" Visibility="{Binding NoteVisibility}" />
                    <ItemsControl Margin="-6,6,-6,0" Focusable="False" ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkTemplate}"
                                  Visibility="{Binding LinksVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource SectionTemplate}" />

        <!-- What the agents learned, for a friend's projects; the workspace's roles and skills, for a teammate. Never
             settings, keys or the user's data. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Share" />
                <TextBlock Style="{StaticResource SectionNoteStyle}"
                           Text="What your agents learned in the tool packs, for a friend's projects, or this workspace's roles and skills, for a teammate: one .linkpack file. Settings, keys and your data never go in." />
                <WrapPanel Margin="-6,6,0,0">
                    <Button Margin="0,0,6,0" Style="{StaticResource SectionButtonStyle}" Click="Share_OnClick"
                            ToolTip="What goes into the file: what your agents learned, or this workspace's roles and skills">
                        <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Share ▾" />
                    </Button>
                    <Button Margin="0" Style="{StaticResource SectionButtonStyle}" Click="OpenPack_OnClick"
                            ToolTip="Take in a .linkpack a friend or a teammate sent: first it shows what it would change">
                        <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Open a pack…" />
                    </Button>
                </WrapPanel>

                <!-- What a file will hold, or what one brings: the ticked items go. -->
                <StackPanel x:Name="PicksPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="PicksHeadingText" Style="{StaticResource SectionNoteStyle}" />
                    <ItemsControl x:Name="PicksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SharePick}">
                                <StackPanel Margin="0,6,0,0">
                                    <CheckBox IsChecked="{Binding Picked}" IsEnabled="{Binding CanPick}">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource SectionNoteStyle}" Margin="22,2,0,0" Text="{Binding Note}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource SectionNoteStyle}" Margin="22,2,0,0" Text="{Binding Warning}" TextWrapping="Wrap"
                                               Foreground="{StaticResource BusyOrbBrush}" Visibility="{Binding WarningVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="-6,8,0,0">
                        <Button Margin="0,0,6,0" Style="{StaticResource SectionButtonStyle}" Click="ConfirmPicks_OnClick">
                            <TextBlock x:Name="ConfirmPicksText" Style="{StaticResource SectionLinkTextStyle}" />
                        </Button>
                        <Button Margin="0" Style="{StaticResource SectionButtonStyle}" Click="CancelPicks_OnClick">
                            <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Cancel" />
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <TextBlock x:Name="PackStatusText" Style="{StaticResource SectionNoteStyle}" Margin="0,4,0,0" Visibility="Collapsed" />
                <Button x:Name="SetUpButton" Margin="-6,4,0,0" HorizontalAlignment="Left" Style="{StaticResource SectionButtonStyle}"
                        Click="SetUp_OnClick" Visibility="Collapsed"
                        ToolTip="A task card for this project: the agent fits the new skills to it. Nothing runs before Run">
                    <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Set up for this project" />
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
