<UserControl x:Class="Link.Desktop.HarnessInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="SectionNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CardNoteStyle}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- Open, View, Console and the team pack's two: text that looks like what it is, a link. -->
        <Style x:Key="SectionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Margin" Value="2,-3,-6,-3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="SectionLinkTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource LinkTextBrush}" />
        </Style>
        <!-- The context's bar turns to a warning near the limit. -->
        <Style x:Key="ContextMeterStyle" TargetType="ProgressBar" BasedOn="{StaticResource UsageBarStyle}">
            <Setter Property="Margin" Value="0,9,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding MeterHigh}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource BusyOrbBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A part of the harness: what it is, a note or two, and a longer text behind a toggle. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:HarnessRow}">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CardHeadingStyle}" Text="{Binding Heading}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Open_OnClick" Visibility="{Binding OpenVisibility}"
                                    ToolTip="Show the file in Explorer">
                                <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Open" />
                            </Button>
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Console_OnClick" Visibility="{Binding ConsoleVisibility}"
                                    ToolTip="What Link gave the agent's CLI and every line it wrote back">
                                <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Console" />
                            </Button>
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Detail_OnClick" Visibility="{Binding DetailToggleVisibility}"
                                    ToolTip="The whole text">
                                <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="{Binding DetailLabel}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- The value; a role's jellyfish in its colour stands before it. -->
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Control Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top" Focusable="False"
                                 Foreground="{Binding RoleBrush}" Template="{StaticResource LinkGlyphTemplate}" Visibility="{Binding RoleVisibility}" />
                        <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource TextBrush}" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                    <ProgressBar Style="{StaticResource ContextMeterStyle}" Value="{Binding MeterPercent, Mode=OneWay}"
                                 Visibility="{Binding MeterVisibility}" />
                    <TextBlock Style="{StaticResource SectionNoteStyle}" Text="{Binding Note}" Visibility="{Binding NoteVisibility}" />
                    <Border Margin="0,8,0,0" CornerRadius="8" Background="{StaticResource InnerGlassBrush}" Visibility="{Binding DetailVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Margin="0,6" Background="{StaticResource HairlineBrush}" CornerRadius="1" />
                            <TextBox Grid.Column="1" Margin="10,8" Padding="0" Style="{StaticResource BareTextBoxStyle}" FontFamily="Consolas" FontSize="11.5"
                                     IsReadOnly="True" MaxHeight="220" Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource SectionTemplate}" />

        <!-- The workspace's roles and skills in one file for a teammate; never settings, keys or the user's data. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Team pack" />
                <TextBlock Style="{StaticResource SectionNoteStyle}"
                           Text="The roles and skills of this workspace in one file, for a teammate's workspace. Settings, keys and your data never go in." />
                <WrapPanel Margin="-6,6,0,0">
                    <Button Margin="0,0,6,0" Style="{StaticResource SectionButtonStyle}" Click="ExportPack_OnClick"
                            ToolTip="Write .agents/roles and .agents/skills of the workspace to a .linkpack file">
                        <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Export team pack…" />
                    </Button>
                    <Button Margin="0" Style="{StaticResource SectionButtonStyle}" Click="ImportPack_OnClick"
                            ToolTip="Put the roles and skills of a .linkpack file into the workspace; one it has already is replaced only if you say so">
                        <TextBlock Style="{StaticResource SectionLinkTextStyle}" Text="Import team pack…" />
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="PackStatusText" Style="{StaticResource SectionNoteStyle}" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
