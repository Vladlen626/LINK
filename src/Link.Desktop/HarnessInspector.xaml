<UserControl x:Class="Link.Desktop.HarnessInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
        </Style>
        <Style x:Key="SectionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Margin" Value="2,-3,-4,-3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- A part of the harness: what it is, a note or two, and a longer text behind a toggle. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:HarnessRow}">
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="{Binding Heading}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Open_OnClick" Visibility="{Binding OpenVisibility}"
                                    ToolTip="Show the file in Explorer">
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Open" />
                            </Button>
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Console_OnClick" Visibility="{Binding ConsoleVisibility}"
                                    ToolTip="What Link gave the agent's CLI and every line it wrote back">
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Console" />
                            </Button>
                            <Button Style="{StaticResource SectionButtonStyle}" Click="Detail_OnClick" Visibility="{Binding DetailToggleVisibility}"
                                    ToolTip="The whole text">
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding DetailLabel}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextBrush}" Text="{Binding Value}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Style="{StaticResource SecondaryTextStyle}" Text="{Binding Note}"
                               TextWrapping="Wrap" Visibility="{Binding NoteVisibility}" />
                    <TextBox Margin="0,6,0,0" Style="{StaticResource BareTextBoxStyle}" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True"
                             MaxHeight="220" Text="{Binding Detail, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding DetailVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="SectionsList" ItemTemplate="{StaticResource SectionTemplate}" />
</UserControl>
