<Window x:Class="Link.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Link" Width="340" MinWidth="320" MaxWidth="1200" SizeToContent="Height"
        AllowsTransparency="True" Background="Transparent" Style="{StaticResource LinkWindowStyle}"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <!-- Sides set the width; the bottom band sets how tall Link may grow (the height always follows the content). -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6,0,6,10" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="Padding" Value="10,8,42,8" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
    </Window.Resources>

    <Border x:Name="ShellBorder" Style="{StaticResource GlassShellStyle}" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid>
            <Border x:Name="ShellRim" BorderBrush="{StaticResource RimLightBrush}" BorderThickness="1"
                    CornerRadius="7" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Margin="13,0,8,0" Background="Transparent" Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="TitleBar_OnPreviewMouseLeftButtonDown"
                      ToolTip="Drag Link · double-click to hide">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                        <Control x:Name="LinkGlyph" Width="20" Height="20" Foreground="{StaticResource BrandBrush}"
                                 Template="{StaticResource LinkGlyphTemplate}" RenderTransformOrigin="0.5,0.5">
                            <Control.RenderTransform><ScaleTransform /></Control.RenderTransform>
                        </Control>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource BrandTextStyle}" Text="LINK" />
                    </StackPanel>

                    <Button x:Name="ProjectMenuButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="26" MinWidth="80"
                            MaxWidth="170" Margin="8,0,4,0" Padding="9,2,8,2" VerticalAlignment="Center"
                            Click="ProjectMenu_OnClick" ToolTip="Switch project">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The linked chat's state stays in sight: "Sign in to ChatGPT" and errors show without the panel. -->
                            <Ellipse x:Name="ChatStatusDot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center"
                                     Fill="{StaticResource IdleOrbBrush}" />
                            <TextBlock x:Name="ProjectNameText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Grid.Column="2" Width="8" Margin="7,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Grid>
                    </Button>

                    <!-- The agent's task in one glance while there is one: who works and how it stands; a click opens it. -->
                    <Button x:Name="AgentPill" Grid.Column="3" Style="{StaticResource ChipButtonStyle}" Height="24" MaxWidth="150"
                            Margin="0,0,4,0" Padding="8,0" VerticalAlignment="Center" Click="AgentPill_OnClick" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AgentPillDot" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center"
                                     Fill="{StaticResource BusyOrbBrush}" />
                            <TextBlock x:Name="AgentPillText" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExpandButton" Grid.Column="4" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                            Click="Expand_OnClick">
                        <Viewbox Width="14" Height="14">
                            <Path x:Name="ExpandIcon" Data="{StaticResource PanelIconGeometry}" Fill="Transparent"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Button>

                    <Button x:Name="HideButton" Grid.Column="5" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                            Click="Hide_OnClick" ToolTip="Hide Link">
                        <Path Width="10" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource HideIconGeometry}"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                            Click="Settings_OnClick" ToolTip="Settings">
                        <Viewbox Width="15" Height="15">
                            <Path Data="{StaticResource SettingsIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Button>
                </Grid>

                <DockPanel x:Name="CardContent" Grid.Row="1" Margin="12,0,12,10">
                    <StackPanel x:Name="InputPanel" DockPanel.Dock="Top">
                        <!-- The project note goes with every question; its first line, the focus, shows here and is edited in the panel. -->
                        <Grid x:Name="NoteChipRow" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="NoteChip" Style="{StaticResource GhostButtonStyle}" Height="26" Padding="8,2"
                                    HorizontalContentAlignment="Left" Click="NoteChip_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                        <Path Data="{StaticResource FlagIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Viewbox>
                                    <TextBlock x:Name="NoteChipText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource TinyIconButtonStyle}" Width="20" Height="20" Margin="2,0,0,0"
                                    VerticalAlignment="Center" Click="RemoveNote_OnClick" ToolTip="Leave the project note out of the next question">
                                <Path Width="7" Height="7" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource MutedBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Border MinHeight="68" MaxHeight="136" Background="{StaticResource InnerGlassBrush}"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}">
                                <Grid>
                                    <TextBox x:Name="PromptBox" Style="{StaticResource InputTextBoxStyle}" MinLines="2" MaxLines="6"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             TextChanged="PromptBox_OnTextChanged" PreviewKeyDown="PromptBox_OnPreviewKeyDown"
                                             LostKeyboardFocus="PromptBox_OnLostKeyboardFocus" />
                                    <TextBlock x:Name="PromptPlaceholder" Margin="12,9,42,0" VerticalAlignment="Top"
                                               Foreground="{StaticResource MutedBrush}" FontSize="13.5" IsHitTestVisible="False" Text="Ask Link…" />
                                    <Button x:Name="SendButton" Style="{StaticResource SendButtonStyle}" Margin="0,0,7,7"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Send_OnClick" ToolTip="Send to linked chat">
                                        <Viewbox Width="14" Height="14">
                                            <Grid Width="24" Height="24">
                                                <Path x:Name="SendIcon" Data="{StaticResource SendIconGeometry}" Fill="Transparent"
                                                      Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Grid>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1.5"
                                    CornerRadius="{StaticResource SurfaceRadius}" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptBox}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>

                        <!-- Where Send sends and how deep; whether Link talks by itself; whether only the user's own text goes. -->
                        <WrapPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <Button x:Name="RouteButton" Style="{StaticResource GhostButtonStyle}" Height="24" Padding="8,2,7,2"
                                    Click="Route_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="RouteText" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" Text="Chat" />
                                    <Path Width="7" Margin="5,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                          Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EffortButton" Style="{StaticResource GhostButtonStyle}" Height="24" Margin="2,0,0,0"
                                    Padding="8,2,7,2" Click="Effort_OnClick" ToolTip="Response effort">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="EffortText" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" Text="Normal" />
                                    <Path Width="7" Margin="5,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                          Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ConversationButton" Style="{StaticResource GhostButtonStyle}" Height="24" Margin="2,0,0,0"
                                    Padding="8,2,8,2" Click="Conversation_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConversationDot" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center"
                                             Fill="{StaticResource IdleOrbBrush}" />
                                    <TextBlock x:Name="ConversationText" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" Text="Conversation" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OnlyMyTextButton" Style="{StaticResource GhostButtonStyle}" Height="24" Margin="2,0,0,0"
                                    Padding="8,2,8,2" Click="OnlyMyText_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="OnlyMyTextDot" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center"
                                             Fill="{StaticResource IdleOrbBrush}" />
                                    <TextBlock x:Name="OnlyMyTextText" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" Text="Only my text" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- What the model will see of the screen, before Send: a screenshot, the work window's fresh frame or nothing. -->
                        <Grid x:Name="SeesRow" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="SeesButton" Style="{StaticResource GhostButtonStyle}" Padding="4,3,8,3"
                                    HorizontalContentAlignment="Stretch" Click="Sees_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="32" CornerRadius="4" Background="{StaticResource InnerGlassBrush}"
                                            BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                                        <Grid>
                                            <Viewbox Width="15" Height="15">
                                                <Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6" StrokeLineJoin="Round" />
                                            </Viewbox>
                                            <Border x:Name="SeesPicture" CornerRadius="3" Visibility="Collapsed">
                                                <Border.Background><ImageBrush x:Name="SeesImage" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SeesTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="SeesDetail" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Path Grid.Column="2" Width="8" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource ChevronIconGeometry}"
                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Button>
                            <Button x:Name="RemoveScreensButton" Grid.Column="1" Style="{StaticResource TinyIconButtonStyle}" Margin="4,0,0,0"
                                    VerticalAlignment="Center" Click="RemoveScreens_OnClick" ToolTip="Remove the screenshots" Visibility="Collapsed">
                                <Path Width="8" Height="8" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <Grid x:Name="ContextActionsPanel" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VoiceButton" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,3,0"
                                    PreviewMouseLeftButtonDown="Voice_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="Voice_OnPreviewMouseLeftButtonUp" ToolTip="Hold to talk">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" /></Viewbox>
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Voice" />
                                </Grid>
                            </Button>
                            <Button x:Name="ClipboardButton" Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}" Margin="3,0,0,0"
                                    Click="Clipboard_OnClick" ToolTip="Attach clipboard">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Viewbox>
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Clipboard" />
                                </Grid>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ContextItemsControl" Margin="0,8,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,5,5" Padding="8,2,2,2" Background="{StaticResource ActiveContextBrush}"
                                            BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Width="13" Height="13" VerticalAlignment="Center">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Clipboard">
                                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Voice">
                                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="ChatSummary">
                                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ChainIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="ProjectState">
                                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource BookmarkIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Application">
                                                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource AppWindowIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                            <TextBlock Margin="5,0,0,0" MaxWidth="230" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                                                       Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            <Button Style="{StaticResource TinyIconButtonStyle}" Width="20" Height="20" Margin="3,0,0,0"
                                                    Click="RemoveContext_OnClick" CommandParameter="{Binding Id}" ToolTip="Remove context">
                                                <Path Width="7" Height="7" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid x:Name="StatusRow" DockPanel.Dock="Bottom" Margin="3,7,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                   Text="Ready" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                            <Border Style="{StaticResource KeyCapStyle}">
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Enter" />
                            </Border>
                            <TextBlock x:Name="SendHintText" Margin="5,0,0,1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                       FontSize="11" Text="sends to ChatGPT" />
                        </StackPanel>
                    </Grid>

                    <!-- Last child: takes the free height of the chosen Link height; without a limit it is capped in code. -->
                    <Border x:Name="ResponsePanel" Margin="0,8,0,0" Padding="12,8,8,10"
                            Background="{StaticResource ResponseSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ResponseStateDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                         Fill="{StaticResource BusyOrbBrush}" />
                                <TextBlock x:Name="ResponseStateText" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Waiting" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="CheckChatButton" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="9,0" FontSize="11"
                                        Click="CheckChat_OnClick" Content="Check chat"
                                        ToolTip="Take the answer from the linked chat if it did not arrive" />
                                <Button x:Name="ReadAloudButton" Grid.Column="3" Height="22" Margin="4,0,0,0" Padding="9,0" FontSize="11"
                                        Click="ReadAloud_OnClick" Content="Listen" Visibility="Collapsed" />
                                <Button Grid.Column="4" Height="22" Margin="4,0" Padding="9,0" FontSize="11"
                                        Click="CopyResponse_OnClick" Content="Copy" />
                                <Button Grid.Column="5" Style="{StaticResource TinyIconButtonStyle}"
                                        Click="CloseResponse_OnClick" ToolTip="Hide response">
                                    <Path Width="8" Height="8" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}"
                                          Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>
                            <!-- What went with the question, as sent: its frame and the chips. -->
                            <Grid x:Name="SawRow" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="SawPictureButton" Style="{StaticResource GhostButtonStyle}" Padding="0" Margin="0,0,7,0"
                                        Click="SawPicture_OnClick" ToolTip="Open the frame that went with the question">
                                    <Border Width="40" Height="24" CornerRadius="3" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                                        <Border.Background><ImageBrush x:Name="SawImage" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                    </Border>
                                </Button>
                                <TextBlock x:Name="SawText" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <FlowDocumentScrollViewer x:Name="ResponseViewer" Grid.Row="2" Margin="0,8,0,0"
                                                      Background="Transparent" BorderThickness="0" IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True"
                                                      SelectionBrush="{StaticResource SelectionBrush}">
                                <FlowDocument x:Name="ResponseDocument" PagePadding="0,0,4,0" FontFamily="Segoe UI"
                                              FontSize="13.5" LineHeight="20" Foreground="{StaticResource TextBrush}" />
                            </FlowDocumentScrollViewer>
                            <!-- The same question again another way, or as a task: nothing is dictated or captured again. -->
                            <WrapPanel x:Name="RedirectPanel" Grid.Row="3" Margin="0,2,0,0" Visibility="Collapsed">
                                <Button x:Name="AskAgainButton" Height="22" Margin="0,4,4,0" Padding="9,0" FontSize="11"
                                        Click="AskAgain_OnClick" Content="Ask again ▾"
                                        ToolTip="The same question again: deeper, with a fresh screen, with only its text, or corrected" />
                                <Button x:Name="ToAgentButton" Height="22" Margin="0,4,0,0" Padding="9,0" FontSize="11"
                                        Click="ToAgent_OnClick" Content="→ Agent task"
                                        ToolTip="Make it a task for the project's agent: a card shows what goes and nothing runs before Run" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- The bottom resize band itself comes from WindowChrome; double-clicking it restores the compact default. -->
                <Border x:Name="ResizeHandle" Grid.Row="1" Width="34" Height="3" Margin="0,0,0,3" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" CornerRadius="1.5" Background="{StaticResource ScrollThumbBrush}"
                        Opacity="0.6" IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
