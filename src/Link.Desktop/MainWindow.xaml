<Window x:Class="Link.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Link" Width="340" MinWidth="320" MaxWidth="400"
        SizeToContent="Height" MaxHeight="620"
        AllowsTransparency="False" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="-1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="LinkGlyphTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Grid Width="24" Height="24">
                    <Path Data="{StaticResource LinkIconGeometry}" Fill="Transparent" Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="2.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path Margin="0,-0.7,0,0" Data="{StaticResource LinkIconGeometry}" Fill="Transparent" Stroke="#AFFFFFFF"
                          StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8" />
                </Grid>
            </Viewbox>
        </ControlTemplate>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8,42,8" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <ContextMenu x:Key="ScreenMenu" x:Shared="False" Placement="Bottom">
            <MenuItem Header="Current monitor" Click="CurrentMonitor_OnClick" />
            <MenuItem Header="All monitors" Click="AllMonitors_OnClick" />
            <MenuItem Header="Full desktop" Click="Desktop_OnClick" />
            <MenuItem Header="Active window" Click="ActiveWindow_OnClick" />
            <MenuItem Header="Select region" Click="Region_OnClick" />
        </ContextMenu>
    </Window.Resources>

    <Border x:Name="ShellBorder" Style="{StaticResource GlassShellStyle}" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid>
            <Border Height="64" VerticalAlignment="Top" Background="{StaticResource GlossBrush}"
                    CornerRadius="18,18,10,10" IsHitTestVisible="False" />
            <Border Margin="1" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="17" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="46" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Margin="12,0,8,0" Background="Transparent" Cursor="SizeAll"
                      PreviewMouseLeftButtonDown="TitleBar_OnPreviewMouseLeftButtonDown"
                      ToolTip="Drag Link · double-click to collapse">
                    <Grid x:Name="ExpandedHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                            <Control x:Name="ExpandedLinkGlyph" Width="23" Height="23" Foreground="{StaticResource AquaBrush}"
                                     Template="{StaticResource LinkGlyphTemplate}" RenderTransformOrigin="0.5,0.5">
                                <Control.RenderTransform><ScaleTransform /></Control.RenderTransform>
                                <Control.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#31B9D4" Opacity="0.34" /></Control.Effect>
                            </Control>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" Text="LINK" />
                        </StackPanel>

                        <Button x:Name="ProjectMenuButton" Grid.Column="2" Height="30" MinWidth="88" MaxWidth="148" Margin="8,0,3,0"
                                Padding="9,4,7,4" VerticalAlignment="Center" Click="ProjectMenu_OnClick" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProjectNameText" MaxWidth="112" VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <Path Width="10" Height="10" Margin="6,1,0,0" Data="{StaticResource ChevronIconGeometry}"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                                Click="Settings_OnClick" ToolTip="Settings" Cursor="Hand">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource SettingsIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <Grid x:Name="CollapsedHeader" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Control x:Name="CollapsedLinkGlyph" Width="23" Height="23" VerticalAlignment="Center"
                                 Foreground="{StaticResource AquaBrush}" Template="{StaticResource LinkGlyphTemplate}"
                                 RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Control.RenderTransform><ScaleTransform /></Control.RenderTransform>
                        </Control>
                        <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="14.5" FontWeight="SemiBold" Text="LINK" IsHitTestVisible="False" />
                        <TextBlock x:Name="CollapsedStatusText" Grid.Column="2" Margin="9,1,4,0" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" Text="Ready" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                        <Button Grid.Column="3" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                                Click="Collapse_OnClick" ToolTip="Expand Link" Cursor="Hand">
                            <Path Width="12" Height="12" Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.RenderTransform><RotateTransform Angle="180" CenterX="6" CenterY="6" /></Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel x:Name="ExpandedContent" Grid.Row="1" Margin="12,0,12,11">
                    <Border Height="30" Background="#28FFFFFF" BorderBrush="{StaticResource GlassBorderSoftBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Text="Task ·" />
                            <Grid Grid.Column="1">
                                <TextBox x:Name="CurrentTaskBox" Padding="5,4,7,4" Background="Transparent" BorderThickness="0" FontSize="12"
                                         ToolTip="Current task" LostFocus="CurrentTaskBox_OnLostFocus" TextChanged="CurrentTaskBox_OnTextChanged" />
                                <TextBlock x:Name="CurrentTaskPlaceholder" Margin="6,0" VerticalAlignment="Center"
                                           Foreground="#7A8492" FontSize="11.5" IsHitTestVisible="False" Text="What are you working on?" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button x:Name="ChatConnectionButton" Height="27" Margin="0,5,0,0" Padding="8,3"
                            HorizontalContentAlignment="Left" Click="ChatConnection_OnClick"
                            ToolTip="Link this project to a ChatGPT conversation">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ChatStatusDot" Width="7" Height="7" Margin="0,0,7,0"
                                     VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="ChatConnectionText" VerticalAlignment="Center" FontSize="11.5"
                                       Text="No linked conversation" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="InputBorder" MinHeight="68" MaxHeight="136" Margin="0,7,0,0"
                            Background="{StaticResource InnerGlassBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource GlassBorderSoftBrush}" />
                                <Setter Property="Effect" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect BlurRadius="9" ShadowDepth="0" Color="#48CAE8" Opacity="0.25" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox x:Name="PromptBox" Style="{StaticResource InputTextBoxStyle}" MinLines="2" MaxLines="6"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     TextChanged="PromptBox_OnTextChanged" />
                            <TextBlock x:Name="PromptPlaceholder" Margin="11,9,42,0" VerticalAlignment="Top"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13.5" IsHitTestVisible="False" Text="Ask Link…" />
                            <Button x:Name="SendButton" Width="28" Height="28" Margin="0,0,6,6" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource AccentActionBrush}"
                                    BorderBrush="{StaticResource AccentBorderBrush}" Click="Send_OnClick" ToolTip="Send to linked chat" Cursor="Hand">
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource SendIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid x:Name="ContextActionsPanel" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ScreenButton" Grid.Column="0" Style="{StaticResource CompactActionButtonStyle}" Margin="0,0,3,0"
                                Click="Screen_OnClick" ToolTip="Attach screen context">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Viewbox>
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Screen" />
                            </Grid>
                        </Button>
                        <Button x:Name="VoiceButton" Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}" Margin="3,0"
                                PreviewMouseLeftButtonDown="Voice_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Voice_OnPreviewMouseLeftButtonUp" ToolTip="Hold to talk">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" /></Viewbox>
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Voice" />
                            </Grid>
                        </Button>
                        <Button x:Name="ClipboardButton" Grid.Column="2" Style="{StaticResource CompactActionButtonStyle}" Margin="3,0,0,0"
                                Click="Clipboard_OnClick" ToolTip="Attach clipboard">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Viewbox>
                                <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Clipboard" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Border x:Name="PreviewPanel" Height="78" Margin="0,7,0,0" Style="{StaticResource GlassCardStyle}"
                            Visibility="Collapsed" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ScreenshotPreview" Margin="3" Stretch="UniformToFill" />
                            <Border Margin="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Background="#B8F5FCFE" BorderBrush="#70FFFFFF" BorderThickness="1" CornerRadius="7">
                                <TextBlock x:Name="PreviewLabel" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold" />
                            </Border>
                            <Button Style="{StaticResource TinyIconButtonStyle}" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="RemovePreview_OnClick" ToolTip="Remove screenshot">
                                <Path Width="12" Height="12" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" />
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="ContextItemsControl" Margin="0,7,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,5,5" Padding="7,3,3,3" Background="{StaticResource ActiveContextBrush}"
                                        BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="11">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Width="13" Height="13" VerticalAlignment="Center">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value><DataTemplate><Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource AquaBrush}" StrokeThickness="1.7" /></DataTemplate></Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Clipboard">
                                                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource AquaBrush}" StrokeThickness="1.7" /></DataTemplate></Setter.Value></Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Voice">
                                                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource AquaBrush}" StrokeThickness="1.7" /></DataTemplate></Setter.Value></Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Label}" />
                                        <Button Style="{StaticResource TinyIconButtonStyle}" Width="19" Height="19" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0" Click="RemoveContext_OnClick"
                                                CommandParameter="{Binding Id}" ToolTip="Remove context">
                                            <Path Width="10" Height="10" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="ResponsePanel" MaxHeight="280" Margin="0,7,0,0" Padding="12,10"
                            Background="{StaticResource ResponseSurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResponseStateText" VerticalAlignment="Center" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Waiting" />
                                <Button Grid.Column="1" Height="22" Margin="4,0" Padding="7,1" FontSize="10.5"
                                        Click="CopyResponse_OnClick" Content="Copy" />
                                <Button Grid.Column="2" Style="{StaticResource TinyIconButtonStyle}"
                                        Click="CloseResponse_OnClick" ToolTip="Hide response">
                                    <Path Width="10" Height="10" Data="{StaticResource CloseIconGeometry}"
                                          Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" />
                                </Button>
                            </Grid>
                            <FlowDocumentScrollViewer x:Name="ResponseViewer" Grid.Row="1" MaxHeight="225" Margin="0,8,0,0"
                                                      Background="Transparent" BorderThickness="0" IsToolBarVisible="False"
                                                      VerticalScrollBarVisibility="Auto" IsSelectionEnabled="True">
                                <FlowDocument x:Name="ResponseDocument" PagePadding="0" FontFamily="Segoe UI"
                                              FontSize="13.75" LineHeight="20.5" Foreground="{StaticResource TextBrush}" />
                            </FlowDocumentScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusText" Height="16" Margin="2,5,2,0" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}" Text="Ready" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
