<Window x:Class="Link.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Link.Desktop"
        Title="Link" Icon="{StaticResource StudioIconImage}" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        Style="{StaticResource LinkWindowStyle}" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <!-- The header is the caption; its buttons say so with IsHitTestVisibleInChrome. -->
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="Padding" Value="10,8,42,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ReadTextStyle" TargetType="TextBox" BasedOn="{StaticResource BareTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- A chat's thread: the questions on the right, the answers on the left. -->
        <DataTemplate DataType="{x:Type local:ThreadUser}">
            <Border Margin="60,12,0,0" HorizontalAlignment="Right" Padding="12,8" CornerRadius="12,12,3,12"
                    Background="{StaticResource ActiveContextBrush}">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                    <Button Margin="-6,3,0,0" Padding="6,1" HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}"
                            Click="UserWords_OnClick" Visibility="{Binding ToggleVisibility}">
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding ToggleLabel}" />
                    </Button>
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Carried}"
                               TextWrapping="Wrap" Visibility="{Binding CarriedVisibility}" />
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding Time}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ThreadAnswer}">
            <Border Margin="0,12,40,0" Padding="12,9" CornerRadius="12,12,12,3" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBox Style="{StaticResource ReadTextStyle}" Text="{Binding Text, Mode=OneWay}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Time}" />
                        <Button Grid.Column="1" Padding="6,1" Style="{StaticResource GhostButtonStyle}" Click="ShowAnswer_OnClick"
                                ToolTip="The whole answer below, as ChatGPT wrote it, with Listen, Copy and → Agent task">
                            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="Show whole" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A project's tab: lit while it is the window's project, with a dot while its agent waits for you or works. -->
        <DataTemplate DataType="{x:Type local:ProjectTab}">
            <Button x:Name="Tab" Height="28" Margin="0,0,4,0" Padding="10,2" Style="{StaticResource GhostButtonStyle}"
                    Foreground="{StaticResource MutedBrush}" ToolTip="{Binding Hint}" Click="ProjectTab_OnClick"
                    AutomationProperties.AutomationId="ProjectTab" AutomationProperties.Name="{Binding Name}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{Binding Dot}"
                             Visibility="{Binding DotVisibility}" />
                    <TextBlock MaxWidth="200" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Text="{Binding Name}" AutomationProperties.AutomationId="{Binding NameId}" />
                    <Path x:Name="Chevron" Width="8" Margin="7,1,0,0" VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed"
                          Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource ActiveContextBrush}" />
                    <Setter TargetName="Tab" Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Padded by the frame while the window is maximized, which WindowChrome lets overflow the screen. -->
    <Border x:Name="Root">
        <Grid>
            <!-- Solid: long reading needs no glass. The rim turns to the recording colour while Link listens. -->
            <Border Background="{StaticResource PanelBrush}" IsHitTestVisible="False" />
            <Border x:Name="ShellRim" BorderBrush="{StaticResource RimLightBrush}" BorderThickness="1" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The caption: the sidebar's toggle, Link with its two tabs; on the Studio tab, on the right, the open task's
                     context with Compact and the Spend and Harness toggles of the right column; Settings and the window's own
                     buttons. -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SidebarButton" Margin="10,0,6,0" Width="32" Height="32" VerticalAlignment="Center"
                                Style="{StaticResource HeaderIconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Sidebar_OnClick">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource SidebarIconGeometry}" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <!-- Breathes while Link listens or talks. -->
                            <Control x:Name="LinkGlyph" Width="20" Height="20" Focusable="False" Foreground="{StaticResource BrandBrush}"
                                     Template="{StaticResource LinkGlyphTemplate}" RenderTransformOrigin="0.5,0.5">
                                <Control.RenderTransform><ScaleTransform /></Control.RenderTransform>
                            </Control>

                            <!-- The two tabs as one switch: the chats with ChatGPT, with a dot while the chat needs a sign-in
                                 or is unavailable, and the Studio of the agents' tasks with the task's standing as a dot. -->
                            <Border Grid.Column="1" Margin="12,0,0,0" Padding="2" VerticalAlignment="Center" CornerRadius="8"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChatTabButton" Height="28" Padding="10,2" Style="{StaticResource GhostButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ChatTab_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="19" Height="16" Margin="0,1,6,0">
                                                <Viewbox Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Path Data="{StaticResource ChatIconGeometry}" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.9" StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <Ellipse x:Name="ChatTabDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Stroke="{StaticResource PanelBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Chat" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StudioTabButton" Height="28" Margin="2,0,0,0" Padding="10,2" Style="{StaticResource GhostButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="StudioTab_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="19" Height="16" Margin="0,1,6,0">
                                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Path Data="{StaticResource CodeIconGeometry}" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <Ellipse x:Name="TaskTabDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Stroke="{StaticResource PanelBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Studio" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="StudioTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="ContextPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="ContextText" VerticalAlignment="Center" FontSize="13" Style="{StaticResource SecondaryTextStyle}" />
                                <!-- How full the session is against its limit, at a glance; the warning colour near it. -->
                                <ProgressBar x:Name="ContextMeter" Width="56" Height="4" Margin="9,1,0,0" VerticalAlignment="Center"
                                             Style="{StaticResource UsageBarStyle}" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" />
                                <Button x:Name="CompactButton" Margin="8,0,0,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                        Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="Compact_OnClick"
                                        ToolTip="A fresh session of the same agent starts from the task's state instead of the session that has grown; you see and can change the state first">
                                    <TextBlock FontSize="13" Text="Compact" />
                                </Button>
                            </StackPanel>
                            <Button x:Name="SpendButton" Margin="8,0,0,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Spend_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,1,7,0">
                                        <Path Data="{StaticResource SpendIconGeometry}" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Spend" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HarnessButton" Margin="4,0,0,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Harness_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,1,7,0">
                                        <Path Data="{StaticResource PanelIconGeometry}" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round" />
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Harness" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="3" Margin="4,0,8,0" Width="32" Height="32" VerticalAlignment="Center"
                                Style="{StaticResource HeaderIconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Settings_OnClick" ToolTip="Settings">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource SettingsIconGeometry}" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Minimize_OnClick" ToolTip="Minimize">
                                <Path Width="10" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource HideIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Maximize_OnClick" ToolTip="Maximize">
                                <Path x:Name="MaximizeIcon" Width="10" Height="10" Stretch="Uniform" Data="{StaticResource MaximizeIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" />
                            </Button>
                            <!-- Link stays in the tray: the hotkey, the tray icon or a second start bring it back. -->
                            <Button Style="{StaticResource CaptionCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Close_OnClick" ToolTip="Hide Link to the tray (Esc)">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The projects as tabs, over both tabs' pages: the window's project lit (its chats and tasks are shown; a
                     click gives its settings, name and ChatGPT conversation), a dot on each whose agent waits for you or
                     works; the agents of every project go on whichever is shown. "+" opens a folder as a project. -->
                <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer x:Name="ProjectStrip" Height="36" Margin="10,0,8,0" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="ProjectStrip_OnMouseWheel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl x:Name="ProjectTabs" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button x:Name="AddProjectButton" Width="28" Height="28" Style="{StaticResource HeaderIconButtonStyle}"
                                    Click="AddProject_OnClick" ToolTip="Open a folder as a project: its own chats, tasks and harness">
                                <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource PlusIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- The tab's page: the chats (their sidebar, the shown chat's thread with the answer on screen, and the
                     question being put together under it), or the tasks (AgentPanel). On the right, in a column that folds
                     away, the project itself (ProjectPanel), on the Studio tab also what the agent really gets (Harness) or
                     where its tokens went (Spend). Clear of the resize band on the right, which would take the scroll bars'
                     clicks. -->
                <Grid Grid.Row="2" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="340" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ChatPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ChatSidebarColumn" Width="264" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ChatsHost" />

                        <Grid Grid.Column="1" MaxWidth="820" Margin="20,10,14,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The shown chat: its name, how Link stands to it, and the whole of it on the ChatGPT page. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ThreadTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ThreadHintText" Margin="0,1,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button x:Name="OpenThreadButton" Grid.Column="1" Margin="10,0,0,0" Height="24" Padding="9,0"
                                        VerticalAlignment="Center" Style="{StaticResource ChipButtonStyle}" Click="OpenThread_OnClick"
                                        ToolTip="Show this chat on Link's ChatGPT page, with what was said there outside Link">
                                    <TextBlock FontSize="12" Text="ChatGPT page" />
                                </Button>
                            </Grid>

                            <ScrollViewer x:Name="ThreadScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,6,12">
                                    <TextBlock x:Name="ThreadEmptyText" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="Nothing asked through Link here yet: ask below; what was said outside Link is on the ChatGPT page." />
                                    <ItemsControl x:Name="ThreadList" Focusable="False" />

                                    <!-- The answer on screen: drawn as it streams, whole, with what went with its question. It stands under
                                         its own chat's thread only; folded, the thread shows it as a glance. -->
                                    <Border x:Name="AnswerHost">
                                        <Border x:Name="ResponsePanel" Margin="0,12,0,0" Padding="12,8,8,10"
                                                Background="{StaticResource ResponseSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="ResponseStateDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             Fill="{StaticResource BusyOrbBrush}" />
                                                    <TextBlock x:Name="ResponseStateText" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Waiting" TextTrimming="CharacterEllipsis" />
                                                    <Button x:Name="CheckChatButton" Grid.Column="2" Height="22" Margin="4,0,0,0" Padding="9,0" FontSize="11"
                                                            Click="CheckChat_OnClick" Content="Check chat"
                                                            ToolTip="Take the answer from the linked chat if it did not arrive" />
                                                    <Button x:Name="ReadAloudButton" Grid.Column="3" Height="22" Margin="4,0,0,0" Padding="9,0" FontSize="11"
                                                            Click="ReadAloud_OnClick" Content="Listen" Visibility="Collapsed" />
                                                    <Button Grid.Column="4" Height="22" Margin="4,0" Padding="9,0" FontSize="11"
                                                            Click="CopyResponse_OnClick" Content="Copy" />
                                                    <Button Grid.Column="5" Style="{StaticResource TinyIconButtonStyle}"
                                                            Click="CloseResponse_OnClick" ToolTip="Fold the answer into the thread">
                                                        <Path Width="8" Height="8" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}"
                                                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Button>
                                                </Grid>
                                                <!-- What went with the question, as sent: its frame and the chips. -->
                                                <Grid x:Name="SawRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button x:Name="SawPictureButton" Style="{StaticResource GhostButtonStyle}" Padding="0" Margin="0,0,7,0"
                                                            Click="SawPicture_OnClick" ToolTip="Open the frame that went with the question">
                                                        <Border Width="40" Height="24" CornerRadius="3" BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                                                            <Border.Background><ImageBrush x:Name="SawImage" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                                        </Border>
                                                    </Button>
                                                    <TextBlock x:Name="SawText" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <!-- As tall as the answer: the thread scrolls, the wheel goes on to it. -->
                                                <FlowDocumentScrollViewer x:Name="ResponseViewer" Margin="0,8,0,0"
                                                                          Background="Transparent" BorderThickness="0" IsToolBarVisible="False"
                                                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                                          IsSelectionEnabled="True" SelectionBrush="{StaticResource SelectionBrush}"
                                                                          PreviewMouseWheel="ResponseViewer_OnPreviewMouseWheel">
                                                    <FlowDocument x:Name="ResponseDocument" PagePadding="0,0,4,0" FontFamily="Segoe UI"
                                                                  FontSize="13" LineHeight="20" Foreground="{StaticResource TextBrush}" />
                                                </FlowDocumentScrollViewer>
                                                <!-- The question as a task: nothing is dictated or captured again. -->
                                                <WrapPanel x:Name="RedirectPanel" Margin="0,2,0,0" Visibility="Collapsed">
                                                    <Button x:Name="ToAgentButton" Height="22" Margin="0,4,0,0" Padding="9,0" FontSize="11"
                                                            Click="ToAgent_OnClick" Content="→ Agent task"
                                                            ToolTip="Make it a task for the project's agent: a card shows what goes and nothing runs before Run" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- The question being put together: the project note, what goes with it, the words, the screen,
                                 voice and the clipboard, where Send sends. -->
                            <StackPanel x:Name="InputPanel" Grid.Row="2" Margin="0,6,0,0">
                                <!-- The project note goes with every question; its first line, the focus, shows here and is edited in the project's column. -->
                                <Grid x:Name="NoteChipRow" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="NoteChip" Style="{StaticResource GhostButtonStyle}" Height="26" Padding="8,2"
                                            HorizontalContentAlignment="Left" Click="NoteChip_OnClick">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Viewbox Width="11" Height="11" VerticalAlignment="Center">
                                                <Path Data="{StaticResource FlagIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Viewbox>
                                            <TextBlock x:Name="NoteChipText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource TinyIconButtonStyle}" Width="20" Height="20" Margin="2,0,0,0"
                                            VerticalAlignment="Center" Click="RemoveNote_OnClick" ToolTip="Leave the project note out of the next question">
                                        <Path Width="7" Height="7" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource MutedBrush}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="ContextItemsControl" Margin="0,4,0,0" Visibility="Collapsed">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,5,5" Padding="8,2,2,2" Background="{StaticResource ActiveContextBrush}"
                                                    BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Width="13" Height="13" VerticalAlignment="Center">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Clipboard">
                                                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Voice">
                                                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="ChatSummary">
                                                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource ChainIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="ProjectState">
                                                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource BookmarkIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Application">
                                                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox><Path Data="{StaticResource AppWindowIconGeometry}" Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round" /></Viewbox></DataTemplate></Setter.Value></Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                    <TextBlock Margin="5,0,0,0" MaxWidth="300" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                    <Button Style="{StaticResource TinyIconButtonStyle}" Width="20" Height="20" Margin="3,0,0,0"
                                                            Click="RemoveContext_OnClick" CommandParameter="{Binding Id}" ToolTip="Remove context">
                                                        <Path Width="7" Height="7" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <Border MinHeight="68" MaxHeight="200" Background="{StaticResource InnerGlassBrush}"
                                            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}">
                                        <Grid>
                                            <TextBox x:Name="PromptBox" Style="{StaticResource InputTextBoxStyle}" MinLines="2" MaxLines="9"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     TextChanged="PromptBox_OnTextChanged" PreviewKeyDown="PromptBox_OnPreviewKeyDown" />
                                            <TextBlock x:Name="PromptPlaceholder" Margin="12,9,42,0" VerticalAlignment="Top"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="13" IsHitTestVisible="False" Text="Ask Link…" />
                                            <Button x:Name="SendButton" Style="{StaticResource SendButtonStyle}" Margin="0,0,7,7"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Send_OnClick" ToolTip="Send to linked chat">
                                                <Viewbox Width="14" Height="14">
                                                    <Grid Width="24" Height="24">
                                                        <Path x:Name="SendIcon" Data="{StaticResource SendIconGeometry}" Fill="Transparent"
                                                              Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2.2"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    </Grid>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1.5"
                                            CornerRadius="{StaticResource SurfaceRadius}" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptBox}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>

                                <!-- Under the words: what the model will see of the screen, voice and the clipboard; where Send sends. -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- A screenshot, the work window's fresh frame or nothing. -->
                                    <Grid x:Name="SeesRow" MaxWidth="320">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button x:Name="SeesButton" Style="{StaticResource GhostButtonStyle}" Padding="4,3,8,3"
                                                HorizontalContentAlignment="Stretch" Click="Sees_OnClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="28" CornerRadius="4" Background="{StaticResource InnerGlassBrush}"
                                                        BorderBrush="{StaticResource GlassBorderSoftBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Data="{StaticResource ScreenIconGeometry}" Fill="Transparent" Stroke="{StaticResource MutedBrush}"
                                                                  StrokeThickness="1.6" StrokeLineJoin="Round" />
                                                        </Viewbox>
                                                        <Border x:Name="SeesPicture" CornerRadius="3" Visibility="Collapsed">
                                                            <Border.Background><ImageBrush x:Name="SeesImage" Stretch="UniformToFill" AlignmentY="Top" /></Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SeesTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="SeesDetail" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Path Grid.Column="2" Width="8" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource ChevronIconGeometry}"
                                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="RemoveScreensButton" Grid.Column="1" Style="{StaticResource TinyIconButtonStyle}" Margin="2,0,0,0"
                                                VerticalAlignment="Center" Click="RemoveScreens_OnClick" ToolTip="Remove the screenshots" Visibility="Collapsed">
                                            <Path Width="8" Height="8" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}" Stroke="{StaticResource TextBrush}"
                                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="ContextActionsPanel" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button x:Name="VoiceButton" Style="{StaticResource CompactActionButtonStyle}"
                                                PreviewMouseLeftButtonDown="Voice_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="Voice_OnPreviewMouseLeftButtonUp" ToolTip="Hold to talk">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource MicrophoneIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" /></Viewbox>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Voice" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClipboardButton" Style="{StaticResource CompactActionButtonStyle}" Margin="6,0,0,0"
                                                Click="Clipboard_OnClick" ToolTip="Attach clipboard">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Path Data="{StaticResource ClipboardIconGeometry}" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Viewbox>
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Clipboard" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Where Send sends: the chat, the agent, or both. -->
                                    <Button x:Name="RouteButton" Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Height="28" Padding="8,2,7,2"
                                            VerticalAlignment="Center" Click="Route_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="RouteText" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Text="Chat" />
                                            <Path Width="7" Margin="5,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                                  Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid x:Name="StatusRow" Margin="3,6,1,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                               Text="Ready" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" IsHitTestVisible="False">
                                        <Border Style="{StaticResource KeyCapStyle}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Enter" />
                                        </Border>
                                        <TextBlock x:Name="SendHintText" Margin="5,0,0,1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                                   FontSize="11" Text="sends to ChatGPT" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="TasksHost" />

                    <!-- Link's viewer over either tab's page: a file the agents or the project column name, opened here. -->
                    <local:FileViewer x:Name="Viewer" Visibility="Collapsed" />

                    <Border x:Name="InspectorHost" Grid.Column="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <local:HarnessInspector x:Name="Inspector" Margin="12,12,6,12" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="SpendScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <local:SpendView x:Name="Spend" Margin="12,12,6,12" />
                            </ScrollViewer>
                            <!-- ProjectPanel scrolls itself. -->
                            <Border x:Name="ProjectHost" Margin="12,12,6,12" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
