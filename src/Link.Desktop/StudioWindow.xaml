<Window x:Class="Link.Desktop.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Link.Desktop"
        Title="Link Studio" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        Style="{StaticResource LinkWindowStyle}" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True">
    <Grid>
        <Border Style="{StaticResource DialogTintStyle}" />
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <!-- The window, the project, and on the right the open task's context with Compact, and the inspector's toggle. -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Control Width="26" Height="26" Focusable="False" Foreground="{StaticResource BrandBrush}"
                             Template="{StaticResource LinkGlyphTemplate}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold" Text="Studio" />
                    <TextBlock x:Name="ProjectText" MaxWidth="320" Margin="12,3,0,0" VerticalAlignment="Center" FontSize="14"
                               Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel x:Name="ContextPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock x:Name="ContextText" VerticalAlignment="Center" FontSize="12.5" Style="{StaticResource SecondaryTextStyle}" />
                        <Button x:Name="CompactButton" Margin="6,0,0,0" Padding="8,2" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                                Click="Compact_OnClick"
                                ToolTip="A fresh session of the same agent starts from the task's state instead of the session that has grown; you see and can change the state first">
                            <TextBlock FontSize="12.5" Text="Compact" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="HarnessButton" Margin="10,0,0,0" Padding="9,2" VerticalAlignment="Center" Style="{StaticResource GhostButtonStyle}"
                            Click="Harness_OnClick">
                        <TextBlock x:Name="HarnessButtonText" FontSize="12.5" FontWeight="SemiBold" Text="Harness" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The tasks in the middle; what the agent really gets on the right, in a column that folds away. -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="320" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TasksHost" />
                <ScrollViewer x:Name="InspectorScroll" Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <local:HarnessInspector x:Name="Inspector" Margin="0,0,6,0" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
