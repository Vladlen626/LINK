<Window x:Class="Link.Desktop.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Link.Desktop"
        Title="Link" Icon="{StaticResource StudioIconImage}" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        Style="{StaticResource LinkWindowStyle}" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <!-- The header is the caption; its buttons say so with IsHitTestVisibleInChrome. -->
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <!-- Padded by the frame while the window is maximized, which WindowChrome lets overflow the screen. -->
    <Border x:Name="Root">
        <Grid>
            <!-- The overlay's panel, solid: long reading needs no glass. -->
            <Border Background="{StaticResource PanelBrush}" IsHitTestVisible="False" />
            <Border BorderBrush="{StaticResource RimLightBrush}" BorderThickness="1" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <!-- The caption: the tasks' toggle, Link with its two tabs and the project; on the Studio tab, on the right, the
                     open task's context with Compact and the Spend and Harness toggles of the right column; the window's own
                     buttons. -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hidden, not collapsed, on the Chat tab: the tabs stay where the pointer left them. -->
                        <Button x:Name="SidebarButton" Margin="10,0,6,0" Width="32" Height="32" VerticalAlignment="Center"
                                Style="{StaticResource HeaderIconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="Sidebar_OnClick">
                            <Viewbox Width="15" Height="15">
                                <Path Data="{StaticResource SidebarIconGeometry}" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" />
                            </Viewbox>
                        </Button>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Control Width="20" Height="20" Focusable="False" Foreground="{StaticResource BrandBrush}"
                                     Template="{StaticResource LinkGlyphTemplate}" />

                            <!-- The two tabs as one switch: the chats with ChatGPT, and the Studio of the agents' tasks with
                                 the task's standing as a dot. -->
                            <Border Grid.Column="1" Margin="12,0,0,0" Padding="2" VerticalAlignment="Center" CornerRadius="8"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChatTabButton" Height="28" Padding="10,2" Style="{StaticResource GhostButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ChatTab_OnClick"
                                            ToolTip="Chat: the project's chats with ChatGPT and what was asked in them (Ctrl+1)">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,1,7,0">
                                                <Path Data="{StaticResource ChatIconGeometry}" Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.9" StrokeLineJoin="Round" />
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Chat" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StudioTabButton" Height="28" Margin="2,0,0,0" Padding="10,2" Style="{StaticResource GhostButtonStyle}"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="StudioTab_OnClick"
                                            ToolTip="Studio: the agents' tasks, their threads, the Harness and the Spend (Ctrl+2)">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="19" Height="16" Margin="0,1,6,0">
                                                <Viewbox Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Path Data="{StaticResource CodeIconGeometry}" Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <Ellipse x:Name="TaskTabDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Stroke="{StaticResource PanelBrush}" StrokeThickness="1.5" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Studio" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- The Studio's own project, apart from the card's: a click lists the projects and its settings. -->
                            <Button x:Name="ProjectButton" Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Height="26" MaxWidth="220"
                                    Margin="10,0,12,0" Padding="9,2,8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Project_OnClick">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProjectText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Path Grid.Column="1" Width="8" Margin="7,1,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                          Data="{StaticResource ChevronIconGeometry}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="StudioTools" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel x:Name="ContextPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="ContextText" VerticalAlignment="Center" FontSize="13" Style="{StaticResource SecondaryTextStyle}" />
                                <!-- How full the session is against its limit, at a glance; the warning colour near it. -->
                                <ProgressBar x:Name="ContextMeter" Width="56" Height="4" Margin="9,1,0,0" VerticalAlignment="Center"
                                             Style="{StaticResource UsageBarStyle}" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" />
                                <Button x:Name="CompactButton" Margin="8,0,0,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                        Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Click="Compact_OnClick"
                                        ToolTip="A fresh session of the same agent starts from the task's state instead of the session that has grown; you see and can change the state first">
                                    <TextBlock FontSize="13" Text="Compact" />
                                </Button>
                            </StackPanel>
                            <Button x:Name="SpendButton" Margin="8,0,0,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Spend_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,1,7,0">
                                        <Path Data="{StaticResource SpendIconGeometry}" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Spend" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HarnessButton" Margin="4,0,8,0" Height="30" Padding="10,2" VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Harness_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" Margin="0,1,7,0">
                                        <Path Data="{StaticResource PanelIconGeometry}" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeLineJoin="Round" />
                                    </Viewbox>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Harness" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Minimize_OnClick" ToolTip="Minimize">
                                <Path Width="10" VerticalAlignment="Center" Stretch="Uniform" Data="{StaticResource HideIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Maximize_OnClick" ToolTip="Maximize">
                                <Path x:Name="MaximizeIcon" Width="10" Height="10" Stretch="Uniform" Data="{StaticResource MaximizeIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" />
                            </Button>
                            <Button Style="{StaticResource CaptionCloseButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Close_OnClick" ToolTip="Close">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The tab's page in the middle: the chats (ChatsPanel) at a reading width, or the tasks (the sidebar and the
                     open task, AgentPanel). On the right, in a column that folds away, the project itself (ProjectPanel), on
                     the Studio tab also what the agent really gets (Harness) or where its tokens went (Spend). Clear of the
                     resize band on the right, which would take the scroll bars' clicks. -->
                <Grid Grid.Row="1" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="InspectorColumn" Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ChatHost" MaxWidth="760" Margin="20,14,14,16" />
                    <Border x:Name="TasksHost" />
                    <Border x:Name="InspectorHost" Grid.Column="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <local:HarnessInspector x:Name="Inspector" Margin="12,12,6,12" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="SpendScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <local:SpendView x:Name="Spend" Margin="12,12,6,12" />
                            </ScrollViewer>
                            <!-- ProjectPanel scrolls itself. -->
                            <Border x:Name="ProjectHost" Margin="12,12,6,12" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
