<UserControl x:Class="Link.Desktop.SpendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Link.Desktop">
    <UserControl.Resources>
        <Style x:Key="FixButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- The task: what it cost, where its tokens went, and whether its cache is still warm. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock x:Name="GoalText" Style="{StaticResource CardHeadingStyle}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource CardNoteStyle}" Margin="0,4,0,0" Visibility="Collapsed"
                           Text="Open a task to see where its tokens went: the brief, the model's writing, files, commands, search, pictures, the CLI's own load." />
                <StackPanel x:Name="TaskPanel">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    ToolTip="≈ tokens weigh each token by its price: a cached input token counts a tenth, an output token five times. They add up across agents and runs.">
                            <TextBlock x:Name="TotalText" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="6,0,0,5" VerticalAlignment="Bottom" Style="{StaticResource SecondaryTextStyle}" FontSize="12" Text="≈ tokens" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <TextBlock x:Name="CostText" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="CostNoteText" HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Text="at API prices" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="WorkText" Margin="0,2,0,0" Style="{StaticResource CardNoteStyle}" />
                    <local:SpendBar x:Name="TaskBar" Height="12" Margin="0,12,0,0" />
                    <ItemsControl x:Name="LegendList" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SpendLegendRow}">
                                <Border Margin="0,0,12,4" Background="Transparent" MouseEnter="Legend_OnMouseEnter" MouseLeave="Legend_OnMouseLeave"
                                        ToolTip="{Binding Hint}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" Margin="0,1,6,0" CornerRadius="2" Background="{Binding Brush}" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" Text="{Binding Name}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Share}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="UnsplitText" Margin="0,2,0,0" Style="{StaticResource CardNoteStyle}" Visibility="Collapsed" />

                    <!-- The cache: warm for so long still, or cold, and what the next turn reads either way. -->
                    <Border x:Name="CacheRow" Margin="0,10,0,0" Padding="10,7" CornerRadius="8" Background="{StaticResource InnerGlassBrush}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Ellipse x:Name="CacheDot" Width="8" Height="8" Margin="0,5,9,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CacheText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="CacheNoteText" Style="{StaticResource CardNoteStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- What stands out, the largest first, with what Link can do about it. -->
        <Border x:Name="TipsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Where to save" />
                <ItemsControl x:Name="TipsList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SpendTipRow}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="8" Height="8" Margin="0,5,9,0" VerticalAlignment="Top" CornerRadius="2" Background="{Binding Brush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CardNoteStyle}" Text="{Binding Why}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource FixButtonStyle}" Content="{Binding FixLabel}" ToolTip="{Binding FixHint}"
                                        Visibility="{Binding FixVisibility}" Click="Fix_OnClick" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The context, request by request: how it grew, where it was compacted, how near the budget it came. -->
        <Border x:Name="CurveCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Context per request" />
                    <TextBlock x:Name="CurveLabelText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <local:SpendCurve x:Name="Curve" Height="124" Margin="0,10,0,0" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource CardNoteStyle}"
                           Text="Every request reads the whole context again, mostly from the cache: a long session costs more per step." />
            </StackPanel>
        </Border>

        <!-- The task's runs, one bar each, as long as their share of the largest. -->
        <Border x:Name="RunsCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Runs" />
                <ItemsControl x:Name="RunsList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SpendRunRow}">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,8,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding Detail}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource TextBrush}" Text="{Binding Amount}" />
                                </Grid>
                                <local:SpendBar Height="6" Margin="0,5,0,0" Gap="1" Parts="{Binding Parts}" Scale="{Binding Scale}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The agents' usage windows: how much is used, this task's part of it, and whether it lasts to the reset. -->
        <Border x:Name="GaugesCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Usage windows" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" Margin="0,1,5,0" CornerRadius="2" Background="{StaticResource IdleOrbBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="used" />
                        <Border Width="8" Height="8" Margin="10,1,5,0" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="this task" />
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="GaugesList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SpendGaugeRow}">
                            <StackPanel Margin="0,9,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextBrush}" Text="{Binding Label}" />
                                    <TextBlock Grid.Column="1" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Used}" />
                                </Grid>
                                <local:SpendGaugeBar Height="6" Margin="0,5,0,0" Gauge="{Binding Gauge}" />
                                <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{Binding NoteBrush}" Text="{Binding Note}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The project's days: a slider for how many, the columns by part, and the day under the pointer below them. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="History" />
                    <CheckBox x:Name="AllProjectsBox" Grid.Column="1" Margin="0" Height="24" Padding="9,0" Style="{StaticResource ToggleChipStyle}"
                              Content="All projects" Checked="Scope_OnChanged" Unchecked="Scope_OnChanged"
                              ToolTip="Count the days of every project, not only this one" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Slider x:Name="RangeSlider" Minimum="7" Maximum="90" SmallChange="1" LargeChange="7" IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="Range_OnValueChanged" ToolTip="How many days back" />
                    <TextBlock x:Name="RangeText" Grid.Column="1" Width="78" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <local:SpendHistory x:Name="History" Height="132" Margin="0,8,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReadoutText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ReadoutCostText" Grid.Column="1" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <local:SpendBar x:Name="ReadoutBar" Height="8" Margin="0,6,0,0" />
                <TextBlock x:Name="HistoryEmptyText" Margin="0,6,0,0" Style="{StaticResource CardNoteStyle}" Visibility="Collapsed"
                           Text="Nothing yet: each run adds to its day as it ends." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
