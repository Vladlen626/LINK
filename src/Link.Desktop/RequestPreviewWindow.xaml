<Window x:Class="Link.Desktop.RequestPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepared Link Request" Width="680" Height="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Request ready for provider" />
        <TextBox x:Name="JsonBox" Grid.Row="1" Margin="0,14,0,14" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <Button Grid.Row="2" HorizontalAlignment="Right" Click="Close_OnClick" Content="Close" />
    </Grid>
</Window>
