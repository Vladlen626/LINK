<Window x:Class="Link.Desktop.RequestPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepared Link Request" Width="700" Height="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowSurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Request ready" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}" Text="This local preview shows exactly what will be handed to a provider." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,16" Style="{StaticResource GlassCardStyle}" Padding="4">
            <TextBox x:Name="JsonBox" Background="#CFFFFFFF" BorderThickness="0" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
        <Button Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="Close_OnClick" Content="Done" />
    </Grid>
</Window>
