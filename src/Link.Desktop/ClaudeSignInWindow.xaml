<Window x:Class="Link.Desktop.ClaudeSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Claude" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Style="{StaticResource LinkWindowStyle}">
    <Grid>
        <Border Style="{StaticResource DialogSurfaceStyle}" />
        <StackPanel Margin="24,18,24,20">
            <TextBlock FontSize="19" FontWeight="SemiBold" Text="Sign in to Claude" />
            <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Link runs Claude Code by itself, so it signs in once on its own, apart from the Claude app. Finish it on the page that opened in your browser: this window closes when it is done." />
            <TextBlock Margin="0,14,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Text="If the page shows a code instead, paste it here:" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="CodeBox" Height="34" FontSize="13" VerticalContentAlignment="Center" KeyDown="CodeBox_OnKeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Send_OnClick" Content="Send code" />
            </Grid>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Text="Waiting for the browser…" />
            <Grid Margin="0,16,0,0">
                <Button HorizontalAlignment="Left" Click="OpenPage_OnClick" Content="Open the page again"
                        ToolTip="The sign-in page in the browser, the kind that shows a code to paste here: for when no page opened or it was closed" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="TryAgainButton" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Click="TryAgain_OnClick" Content="Try again" ToolTip="Starts the sign-in over: the page opens in the browser again" />
                    <Button x:Name="CloseButton" Click="Close_OnClick" Content="Cancel" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
