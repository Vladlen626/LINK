<Window x:Class="Link.Desktop.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Link.Desktop"
        xmlns:services="clr-namespace:Link.Desktop.Services"
        Title="Review changes · Link" Width="1180" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource LinkWindowStyle}" ShowInTaskbar="False">
    <Window.Resources>
        <!-- A row of a list with no selection chrome of its own: lit under the pointer, the accent tint while chosen. -->
        <Style x:Key="PlainItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ActiveContextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource PlainItemStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Padding="8,6" Background="Transparent" CornerRadius="{StaticResource SurfaceRadius}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ActiveContextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumberStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource DialogSurfaceStyle}" />
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,10" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           Text="Click a line to comment on it; with no line chosen, the comment is on the whole change. Send review gives all the comments to the agent as your next words." />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <!-- The files, in the diff's order: how each changed, its numbers and its comments. -->
                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="6">
                    <ListBox x:Name="FilesList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FileItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Files_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReviewFileRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        <Border Grid.Column="1" Margin="6,0,0,0" Padding="6,0" CornerRadius="8" Background="{StaticResource AccentActionBrush}"
                                                Visibility="{Binding CommentsVisibility}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentForegroundBrush}" Text="{Binding Comments}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource SuccessBrush}" Text="{Binding AddedText}" />
                                        <TextBlock Margin="6,0,0,0" FontSize="11.5" Foreground="{StaticResource ErrorBrush}" Text="{Binding RemovedText}" />
                                        <TextBlock Margin="8,0,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Text="{Binding Folder}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- The chosen file's diff: old and new line numbers, the sign, the code; a comment under its line. -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="0,6">
                    <ListBox x:Name="LinesList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Lines_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReviewRow}">
                                <Border x:Name="Line" Padding="0,1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource NumberStyle}" Text="{Binding OldNumber}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource NumberStyle}" Text="{Binding NewNumber}" />
                                            <TextBlock x:Name="Sign" Grid.Column="2" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Text="{Binding Sign}" />
                                            <TextBlock x:Name="Code" Grid.Column="3" Margin="0,0,10,0" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                       Foreground="{StaticResource TextBrush}" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Border Margin="110,4,12,5" Padding="10,6" CornerRadius="{StaticResource SurfaceRadius}" Background="{StaticResource PopupSurfaceBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" Visibility="{Binding CommentVisibility}">
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextBrush}" Text="{Binding Comment}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffLineKind.Added}">
                                        <Setter TargetName="Line" Property="Background" Value="{StaticResource DiffAddedBrush}" />
                                        <Setter TargetName="Sign" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffLineKind.Removed}">
                                        <Setter TargetName="Line" Property="Background" Value="{StaticResource DiffRemovedBrush}" />
                                        <Setter TargetName="Sign" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffLineKind.Hunk}">
                                        <Setter TargetName="Line" Property="Background" Value="{StaticResource SubtleGlassBrush}" />
                                        <Setter TargetName="Line" Property="Margin" Value="0,6,0,2" />
                                        <Setter TargetName="Code" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:DiffLineKind.Note}">
                                        <Setter TargetName="Code" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter TargetName="Code" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- The comment being written: on the chosen line, or on the whole change. -->
            <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlaceText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="WholeButton" Grid.Column="1" Margin="8,-4,-6,0" Padding="6,1" Style="{StaticResource GhostButtonStyle}"
                            Click="Whole_OnClick" Content="On the whole change" ToolTip="Comment on the change as a whole, not a line (Esc)" />
                    <TextBox x:Name="CommentBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" Style="{StaticResource BareTextBoxStyle}" Padding="0,2"
                             FontSize="13" MinHeight="40" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="CommentBox_OnPreviewKeyDown" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                <Button x:Name="SaveButton" Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource ChipButtonStyle}" Click="Save_OnClick"
                        Content="Add comment" ToolTip="Keep the comment on its place (Ctrl+Enter); an empty one removes it" />
                <Button Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource ChipButtonStyle}" Click="Cancel_OnClick" Content="Cancel"
                        ToolTip="Close the review: nothing goes to the agent" />
                <Button x:Name="SendButton" Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Height="30" Click="Send_OnClick"
                        Content="Send review" ToolTip="All the comments go to the agent as your next words: it answers each" />
            </Grid>
        </Grid>
    </Grid>
</Window>
