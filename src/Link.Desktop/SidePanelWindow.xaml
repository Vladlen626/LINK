<Window x:Class="Link.Desktop.SidePanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Link panel" Width="300" Height="440" AllowsTransparency="True" Background="Transparent"
        Style="{StaticResource LinkWindowStyle}" ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <!-- Only the outer side resizes: the one away from the card, set when the panel is placed. -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="ShellBorder" Style="{StaticResource GlassShellStyle}" SnapsToDevicePixels="True" ClipToBounds="True">
        <Grid>
            <Border BorderBrush="{StaticResource RimLightBrush}" BorderThickness="1" CornerRadius="7" IsHitTestVisible="False" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="15,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" Style="{StaticResource BrandTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Style="{StaticResource HeaderIconButtonStyle}" VerticalAlignment="Center"
                            Click="Close_OnClick" ToolTip="Close the panel (Esc)">
                        <Path Width="9" Height="9" Stretch="Uniform" Data="{StaticResource CloseIconGeometry}"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <ContentPresenter x:Name="Body" Grid.Row="1" Margin="12,0,12,12" />
            </Grid>
        </Grid>
    </Border>
</Window>
